<style>
    @@keyframes checkout-pop {
        0% { opacity: 0; transform: translateY(18px) scale(0.92); }
        70% { opacity: 1; transform: translateY(0) scale(1.04); }
        100% { opacity: 1; transform: translateY(0) scale(1); }
    }

    @@keyframes checkout-check {
        0% { stroke-dashoffset: 48; }
        100% { stroke-dashoffset: 0; }
    }

    .checkout-notice-show {
        animation: checkout-pop 360ms ease-out both;
    }

    .checkout-check-path {
        stroke-dasharray: 48;
        stroke-dashoffset: 48;
        animation: checkout-check 520ms ease-out 160ms forwards;
    }
</style>

<nav class="sticky top-0 z-50 bg-surface shadow-[0_10px_30px_rgba(62,39,35,0.05)]">
    <div class="mx-auto flex w-full max-w-container-max items-center justify-between px-margin-mobile py-unit md:px-margin-desktop">
        <a asp-controller="Product" asp-action="Index" class="flex items-center gap-3">
            <partial name="_SakuraLogoMark" />
            <h1 class="font-['Noto_Serif'] text-[32px] font-bold leading-none">
                <span style="color:#3e2723">Coffe</span><span style="color:#81c784">-latte</span><span style="color:#f48fb1">Kawaii</span>
            </h1>
        </a>
        <div class="hidden items-center gap-gutter md:flex">
            <a class="font-body-md border-b-2 border-primary pb-1 text-primary" href="#menu">Menu</a>
            @if (User.IsInRole("Admin"))
            {
                <a class="font-body-md text-secondary transition-colors duration-200 hover:text-primary" asp-controller="Product" asp-action="Add">Manager</a>
            }
        </div>
        <div class="flex items-center gap-unit">
            @if (isAuthenticated)
            {
                <partial name="_UserAvatarHeader" />
                <a asp-controller="Account" asp-action="Profile" class="rounded-lg px-3 py-2 font-label-md text-primary transition-colors hover:bg-secondary-container">Trang cá nhân</a>
                <a asp-controller="Account" asp-action="PurchaseHistory" class="rounded-lg px-3 py-2 font-label-md text-primary transition-colors hover:bg-secondary-container">Lịch sử</a>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="rounded-lg px-3 py-2 font-label-md text-primary transition-colors hover:bg-secondary-container">Đăng xuất</button>
                </form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="rounded-lg px-3 py-2 font-label-md text-primary transition-colors hover:bg-secondary-container">Đăng nhập</a>
            }
            <button class="relative rounded-full p-2 text-primary transition-colors hover:bg-secondary-container" onclick="toggleCart()" aria-label="Mở giỏ hàng">
                <span class="material-symbols-outlined">shopping_cart</span>
                <span id="cartCount" class="absolute right-0 top-0 flex h-4 w-4 items-center justify-center rounded-full bg-primary text-[10px] text-white">0</span>
            </button>
            <button class="p-2 text-primary md:hidden" aria-label="Menu">
                <span class="material-symbols-outlined">menu</span>
            </button>
        </div>
    </div>
</nav>

<div id="cartBackdrop" class="fixed inset-0 z-[55] hidden bg-primary/30 backdrop-blur-sm" onclick="closeCart()"></div>

<div id="cartDrawer" class="fixed right-0 top-0 z-[60] flex h-full w-full translate-x-full flex-col bg-surface-container-lowest shadow-2xl transition-transform duration-300 lg:w-[400px]">
    <div class="flex items-center justify-between border-b border-outline-variant p-gutter">
        <div>
            <h2 class="font-headline-md text-headline-md text-primary">Giỏ hàng của bạn</h2>
            <p class="font-caption text-caption text-secondary">Những món Coffe đã chọn</p>
        </div>
        <button class="rounded-full p-2 hover:bg-surface-container" onclick="closeCart()" aria-label="Đóng giỏ hàng">
            <span class="material-symbols-outlined">close</span>
        </button>
    </div>
    <div id="cartItems" class="flex-grow space-y-gutter overflow-y-auto p-gutter"></div>
    <div class="space-y-4 border-t border-outline-variant bg-surface-container p-gutter">
        <div class="flex justify-between font-label-md text-label-md text-primary">
            <span>Tạm tính</span>
            <span id="cartSubtotal">0 VNĐ</span>
        </div>
        <button id="checkoutBtn" class="flex w-full items-center justify-between rounded-lg bg-primary px-6 py-4 font-label-md text-on-primary transition-soft hover:brightness-110">
            <span>Mua hàng</span>
            <span class="material-symbols-outlined">arrow_forward</span>
        </button>
        <button id="clearCartBtn" class="flex w-full items-center justify-center gap-2 rounded-lg border border-outline-variant px-6 py-3 font-label-md text-secondary transition-soft hover:bg-surface-container-high hover:text-error">
            <span class="material-symbols-outlined text-[18px]">delete</span>
            <span>Xóa hết giỏ hàng</span>
        </button>
    </div>
</div>

<div id="checkoutNotice" class="fixed inset-0 z-[90] hidden items-center justify-center bg-primary/35 px-margin-mobile backdrop-blur-sm">
    <div id="checkoutNoticeCard" class="w-full max-w-sm rounded-2xl border border-outline-variant/20 bg-surface-container-lowest p-gutter text-center shadow-2xl">
        <div id="checkoutNoticeIconWrap" class="mx-auto mb-5 flex h-20 w-20 items-center justify-center rounded-full bg-[#e8f5e9] text-[#2e7d32]">
            <svg class="h-12 w-12" viewBox="0 0 52 52" aria-hidden="true">
                <circle cx="26" cy="26" r="23" fill="none" stroke="currentColor" stroke-width="3" opacity=".22"></circle>
                <path class="checkout-check-path" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="5" d="M15 27.5 22.5 35 38 18"></path>
            </svg>
        </div>
        <h2 id="checkoutNoticeTitle" class="mb-2 font-headline-md text-headline-md text-primary">Đã mua sản phẩm Coffe</h2>
        <p id="checkoutNoticeMessage" class="font-body-md text-secondary">Cảm ơn bạn đã mua hàng tại Coffe Latte Kawaii.</p>
        <button id="checkoutNoticeClose" type="button" class="mt-6 rounded-lg bg-primary px-6 py-3 font-label-md text-on-primary transition hover:brightness-110">Tiếp tục mua hàng</button>
    </div>
</div>

<main class="mx-auto max-w-container-max px-margin-mobile py-gutter md:px-margin-desktop">
    <section id="heroCarousel" class="group relative mb-section-gap h-[400px] overflow-hidden rounded-xl" data-interval="5000">
        <div class="relative h-full overflow-hidden">
            @for (var bannerIndex = 0; bannerIndex < heroBanners.Count; bannerIndex++)
            {
                <img class="hero-slide absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-700 @(bannerIndex == 0 ? "is-active opacity-100" : "")" src="@heroBanners[bannerIndex]" alt="Banner Coffe Latte Kawaii @(bannerIndex + 1)" data-slide-index="@bannerIndex" />
            }
            <div class="hero-gradient pointer-events-none absolute inset-0 flex items-end p-gutter">
                <div class="max-w-xl text-white">
                    <h1 class="mb-4 font-display-lg text-display-lg">Hương Vị Nghệ Thuật</h1>
                    <p class="font-body-lg text-body-lg opacity-90">Sự kết hợp hoàn hảo giữa tâm hồn Sài Gòn và hơi thở cố đô Kyoto.</p>
                </div>
            </div>
        </div>
        @if (heroBanners.Count > 1)
        {
            <button type="button" class="hero-arrow absolute left-4 top-1/2 flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded-full bg-white/25 text-white opacity-45 backdrop-blur-md transition hover:bg-white/40 hover:opacity-90" data-carousel-prev aria-label="Banner trước">
                <span class="material-symbols-outlined text-[22px]">chevron_left</span>
            </button>
            <button type="button" class="hero-arrow absolute right-4 top-1/2 flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded-full bg-white/25 text-white opacity-45 backdrop-blur-md transition hover:bg-white/40 hover:opacity-90" data-carousel-next aria-label="Banner tiếp theo">
                <span class="material-symbols-outlined text-[22px]">chevron_right</span>
            </button>
            <div class="absolute bottom-4 left-1/2 flex -translate-x-1/2 items-center gap-2">
                @for (var bannerIndex = 0; bannerIndex < heroBanners.Count; bannerIndex++)
                {
                    <button type="button" class="hero-dot h-2.5 w-2.5 rounded-full bg-white/45 transition-all @(bannerIndex == 0 ? "w-7 bg-white/90" : "")" data-carousel-dot="@bannerIndex" aria-label="Chuyển đến banner @(bannerIndex + 1)"></button>
                }
            </div>
        }
    </section>

    <section class="hide-scrollbar mb-gutter flex gap-4 overflow-x-auto py-2">
        @foreach (var category in categories)
        {
            <button class="category-btn whitespace-nowrap rounded-full border border-outline bg-surface px-6 py-2 font-label-md text-primary transition-soft hover:bg-secondary-container" data-category-id="@category.CategoryId">@category.Name</button>
        }
    </section>

    <section class="grid grid-cols-1 gap-gutter @(showPromoBanner ? "xl:grid-cols-[minmax(0,1fr)_280px]" : "")">
        <div id="menu" class="grid grid-cols-1 gap-gutter md:grid-cols-2 lg:grid-cols-3">
            @for (var index = 0; index < products.Count; index++)
            {
                var product = products[index];
                var imageUrl = ImageOf(product, index);
                <article class="product-card group overflow-hidden rounded-xl bg-surface-container-lowest shadow-[0_10px_30px_rgba(62,39,35,0.05)] transition-soft hover:-translate-y-1 hover:shadow-xl" data-category-id="@product.CategoryId">
                    <button type="button" class="js-open-detail block w-full text-left" data-product-id="@product.Id" data-name="@product.Name" data-description="@product.Description" data-price="@product.Price.ToString(CultureInfo.InvariantCulture)" data-display-price="@product.Price.ToString("N0") VNĐ" data-image="@imageUrl">
                        <div class="relative aspect-square cursor-pointer overflow-hidden">
                            <img class="h-full w-full object-cover transition-soft group-hover:scale-105" src="@imageUrl" alt="@product.Name" />
                            <div class="absolute right-4 top-4 rounded-full bg-white/80 p-2 backdrop-blur-md">
                                <span class="material-symbols-outlined text-primary">@IconOf(product.Name)</span>
                            </div>
                        </div>
                        <div class="p-gutter">
                            <h3 class="mb-1 font-headline-md text-headline-md text-primary">@product.Name</h3>
                            <p class="mb-4 line-clamp-2 font-body-md text-secondary">@product.Description</p>
                            <div class="flex items-center justify-between gap-3">
                                <span class="font-label-md text-lg text-on-tertiary-container">@product.Price.ToString("N0") VNĐ</span>
                                <span class="rounded-lg bg-primary px-4 py-2 font-label-md text-on-primary transition-soft hover:brightness-125">Thêm vào giỏ</span>
                            </div>
                        </div>
                    </button>
                </article>
            }
        </div>
        @if (showPromoBanner)
        {
            <aside class="hidden xl:block">
                <div class="sticky top-28 overflow-hidden rounded-xl border border-outline-variant/20 bg-surface-container-lowest shadow-[0_10px_30px_rgba(62,39,35,0.08)]">
                    @if (!string.IsNullOrWhiteSpace(promoBanner.LinkUrl))
                    {
                        <a href="@promoBanner.LinkUrl" class="block">
                            <img src="@promoBanner.ImageUrl" alt="@promoBanner.Title" class="h-[360px] w-full object-cover" />
                        </a>
                    }
                    else
                    {
                        <img src="@promoBanner.ImageUrl" alt="@promoBanner.Title" class="h-[360px] w-full object-cover" />
                    }
                    <div class="space-y-2 p-4">
                        <div class="flex items-center gap-2 text-caption font-bold uppercase tracking-widest text-secondary">
                            <span class="material-symbols-outlined text-[16px]">local_offer</span>
                            Khuyến mãi
                        </div>
                        <h2 class="font-headline-md text-headline-md text-primary">@promoBanner.Title</h2>
                        <p class="text-caption text-secondary">@promoBanner.Description</p>
                    </div>
                </div>
            </aside>
        }
    </section>
</main>

