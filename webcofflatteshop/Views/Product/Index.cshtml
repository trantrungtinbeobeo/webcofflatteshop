@section Scripts {
<script>
(() => {
    const heroCarousel = document.getElementById('heroCarousel');
    if (heroCarousel) {
        const slides = Array.from(heroCarousel.querySelectorAll('.hero-slide'));
        const dots = Array.from(heroCarousel.querySelectorAll('.hero-dot'));
        const prevButton = heroCarousel.querySelector('[data-carousel-prev]');
        const nextButton = heroCarousel.querySelector('[data-carousel-next]');
        const intervalMs = Number(heroCarousel.dataset.interval || 5000);
        let activeSlide = 0;
        let carouselTimer = null;

        const showSlide = index => {
            if (!slides.length) return;

            activeSlide = (index + slides.length) % slides.length;
            slides.forEach((slide, slideIndex) => {
                const isActive = slideIndex === activeSlide;
                slide.classList.toggle('opacity-100', isActive);
                slide.classList.toggle('opacity-0', !isActive);
                slide.classList.toggle('is-active', isActive);
            });
            dots.forEach((dot, dotIndex) => {
                const isActive = dotIndex === activeSlide;
                dot.classList.toggle('w-7', isActive);
                dot.classList.toggle('bg-white/90', isActive);
                dot.classList.toggle('bg-white/45', !isActive);
            });
        };

        const restartCarousel = () => {
            if (carouselTimer) window.clearInterval(carouselTimer);
            if (slides.length <= 1) return;

            carouselTimer = window.setInterval(() => {
                showSlide(activeSlide + 1);
            }, intervalMs);
        };

        prevButton?.addEventListener('click', () => {
            showSlide(activeSlide - 1);
            restartCarousel();
        });
        nextButton?.addEventListener('click', () => {
            showSlide(activeSlide + 1);
            restartCarousel();
        });
        dots.forEach(dot => {
            dot.addEventListener('click', () => {
                showSlide(Number(dot.dataset.carouselDot));
                restartCarousel();
            });
        });

        showSlide(0);
        restartCarousel();
    }

    const productPrices = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(productPrices));
    const isAuthenticated = @Json.Serialize(isAuthenticated);
    const toNumber = value => {
        if (typeof value === 'number') return Number.isFinite(value) ? value : 0;

        const raw = String(value ?? '').trim();
        const normalized = raw.includes(',')
            ? raw.replace(/\./g, '').replace(',', '.')
            : /^\d{1,3}(\.\d{3})+$/.test(raw)
                ? raw.replace(/\./g, '')
                : raw;
        const parsed = Number(normalized);
        return Number.isFinite(parsed) ? parsed : 0;
    };
    const formatCurrency = value => `${toNumber(value).toLocaleString('vi-VN')} VNĐ`;
    const priceForCartItem = item => {
        const currentPrice = toNumber(item.price);
        if (currentPrice > 0) return currentPrice;

        let repairedPrice = toNumber(productPrices[item.name]);
        if (item.size === 'Nhỏ') repairedPrice -= 5000;
        else if (item.size === 'Lớn') repairedPrice += 10000;

        return Math.max(repairedPrice, 0);
    };
    const normalizeCart = cart => cart.map(item => ({
        ...item,
        qty: Number.isFinite(Number(item.qty)) && Number(item.qty) > 0 ? Number(item.qty) : 1,
        price: priceForCartItem(item)
    }));
    const getCart = () => normalizeCart(JSON.parse(localStorage.getItem('coffee_cart') || '[]'));
    const setCart = value => localStorage.setItem('coffee_cart', JSON.stringify(value));
    const cartDrawer = document.getElementById('cartDrawer');
    const cartBackdrop = document.getElementById('cartBackdrop');
    const cartCount = document.getElementById('cartCount');
    const cartItems = document.getElementById('cartItems');
    const cartSubtotal = document.getElementById('cartSubtotal');
    const clearCartBtn = document.getElementById('clearCartBtn');
    const checkoutNotice = document.getElementById('checkoutNotice');
    const checkoutNoticeCard = document.getElementById('checkoutNoticeCard');
    const checkoutNoticeTitle = document.getElementById('checkoutNoticeTitle');
    const checkoutNoticeMessage = document.getElementById('checkoutNoticeMessage');
    const checkoutNoticeIconWrap = document.getElementById('checkoutNoticeIconWrap');
    const checkoutNoticeClose = document.getElementById('checkoutNoticeClose');
    let current = null;
    let selectedSugar = "100%";
    let selectedSize = "Vừa";

    const openCart = () => {
        cartDrawer.classList.remove('translate-x-full');
        cartBackdrop.classList.remove('hidden');
    };
    window.closeCart = () => {
        cartDrawer.classList.add('translate-x-full');
        cartBackdrop.classList.add('hidden');
    };
    window.toggleCart = () => {
        if (cartDrawer.classList.contains('translate-x-full')) openCart();
        else closeCart();
    };
    window.closeDetail = () => {
        document.getElementById('detailModal').classList.add('hidden');
        document.getElementById('detailModal').classList.remove('flex');
    };

    const renderCart = () => {
        const cart = getCart();
        cartCount.textContent = cart.reduce((sum, item) => sum + item.qty, 0);
        cartSubtotal.textContent = formatCurrency(cart.reduce((sum, item) => sum + item.price * item.qty, 0));
        cartItems.innerHTML = cart.length
            ? cart.map((item, index) => `
                <div class="flex gap-4 border-b border-outline-variant/10 pb-3">
                    <div class="h-20 w-20 flex-shrink-0 overflow-hidden rounded-lg">
                        <img class="h-full w-full object-cover" src="${item.image}" alt="${item.name}">
                    </div>
                    <div class="flex-grow">
                        <div class="flex items-start justify-between gap-3">
                            <p class="font-label-md text-label-md text-primary font-semibold">${item.name}</p>
                            <button type="button" class="js-remove-cart-item rounded-full p-1 text-secondary transition-colors hover:bg-error-container hover:text-error" data-cart-index="${index}" aria-label="Xóa ${item.name} khỏi giỏ hàng">
                                <span class="material-symbols-outlined text-[18px]">delete</span>
                            </button>
                        </div>
                        <p class="text-[12px] text-secondary mt-0.5">Size: ${item.size} | Đường: ${item.sugar}</p>
                        <p class="font-caption text-caption text-secondary">Số lượng: ${item.qty}</p>
                        <div class="mt-1 flex items-center justify-between">
                            <span class="font-body-md text-primary font-medium">${formatCurrency(item.price * item.qty)}</span>
                        </div>
                    </div>
                </div>`).join('')
            : '<p class="font-body-md text-secondary">Chưa có sản phẩm nào.</p>';
    };

    const removeCartItem = index => {
        const cart = getCart();
        cart.splice(index, 1);
        setCart(cart);
        renderCart();
    };

    const clearCart = () => {
        localStorage.removeItem('coffee_cart');
        renderCart();
    };

    const addToCart = item => {
        const cart = getCart();
        const index = cart.findIndex(entry => entry.name === item.name && entry.sugar === item.sugar && entry.size === item.size);
        if (index >= 0) cart[index].qty += 1;
        else cart.push({ ...item, qty: 1 });
        setCart(cart);
        renderCart();
        openCart();
    };

    const showCheckoutNotice = ({ title, message, type = 'success' }) => {
        checkoutNoticeTitle.textContent = title;
        checkoutNoticeMessage.textContent = message;
        checkoutNoticeIconWrap.className = type === 'success'
            ? 'mx-auto mb-5 flex h-20 w-20 items-center justify-center rounded-full bg-[#e8f5e9] text-[#2e7d32]'
            : 'mx-auto mb-5 flex h-20 w-20 items-center justify-center rounded-full bg-error-container text-error';
        checkoutNotice.classList.remove('hidden');
        checkoutNotice.classList.add('flex');
        checkoutNoticeCard.classList.remove('checkout-notice-show');
        void checkoutNoticeCard.offsetWidth;
        checkoutNoticeCard.classList.add('checkout-notice-show');
    };

    const hideCheckoutNotice = () => {
        checkoutNotice.classList.add('hidden');
        checkoutNotice.classList.remove('flex');
    };

    checkoutNoticeClose.addEventListener('click', hideCheckoutNotice);
    checkoutNotice.addEventListener('click', event => {
        if (event.target === checkoutNotice) hideCheckoutNotice();
    });

    cartItems.addEventListener('click', event => {
        const removeButton = event.target.closest('.js-remove-cart-item');
        if (!removeButton) return;

        removeCartItem(Number(removeButton.dataset.cartIndex));
    });

    clearCartBtn.addEventListener('click', () => {
        if (!getCart().length) return;
        clearCart();
    });

    // Chi tiết sản phẩm & Lựa chọn thuộc tính
    document.querySelectorAll('.js-open-detail').forEach(button => {
        button.addEventListener('click', () => {
            const basePrice = toNumber(button.dataset.price);
            current = { 
                productId: Number(button.dataset.productId),
                name: button.dataset.name, 
                basePrice: basePrice,
                price: basePrice, 
                image: button.dataset.image 
            };

            document.getElementById('detailTitle').textContent = button.dataset.name;
            document.getElementById('detailDesc').textContent = button.dataset.description || 'Món quà từ thiên nhiên với quy trình chế biến thủ công.';
            
            // Khởi tạo trạng thái mặc định
            selectedSugar = "100%";
            selectedSize = "Vừa";
            updateDetailPrice();

            // Reset classes cho Đường
            document.querySelectorAll('.sugar-option-btn').forEach(btn => {
                if (btn.dataset.sugar === "100%") {
                    btn.className = "sugar-option-btn rounded-full border border-primary bg-primary px-4 py-1 font-caption text-on-primary";
                } else {
                    btn.className = "sugar-option-btn rounded-full border border-outline px-4 py-1 font-caption text-secondary";
                }
            });

            // Reset classes cho Size
            document.querySelectorAll('.size-option-btn').forEach(btn => {
                if (btn.dataset.size === "Vừa") {
                    btn.className = "size-option-btn rounded-full border border-primary bg-primary px-4 py-1 font-caption text-on-primary";
                } else {
                    btn.className = "size-option-btn rounded-full border border-outline px-4 py-1 font-caption text-secondary";
                }
            });

            document.getElementById('detailImg').src = button.dataset.image;
            document.getElementById('detailModal').classList.remove('hidden');
            document.getElementById('detailModal').classList.add('flex');
        });
    });

    const updateDetailPrice = () => {
        if (!current) return;
        let finalPrice = current.basePrice;
        if (selectedSize === "Nhỏ") finalPrice -= 5000;
        else if (selectedSize === "Lớn") finalPrice += 10000;
        
        current.price = finalPrice;
        document.getElementById('detailPrice').textContent = formatCurrency(finalPrice);
    };

    // Click chọn Đường
    document.querySelectorAll('.sugar-option-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            selectedSugar = btn.dataset.sugar;
            document.querySelectorAll('.sugar-option-btn').forEach(b => {
                if (b === btn) {
                    b.className = "sugar-option-btn rounded-full border border-primary bg-primary px-4 py-1 font-caption text-on-primary";
                } else {
                    b.className = "sugar-option-btn rounded-full border border-outline px-4 py-1 font-caption text-secondary";
                }
            });
        });
    });

    // Click chọn Size
    document.querySelectorAll('.size-option-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            selectedSize = btn.dataset.size;
            document.querySelectorAll('.size-option-btn').forEach(b => {
                if (b === btn) {
                    b.className = "size-option-btn rounded-full border border-primary bg-primary px-4 py-1 font-caption text-on-primary";
                } else {
                    b.className = "size-option-btn rounded-full border border-outline px-4 py-1 font-caption text-secondary";
                }
            });
            updateDetailPrice();
        });
    });

    document.getElementById('detailAddBtn').addEventListener('click', () => {
        if (current) {
            addToCart({
                name: current.name,
                productId: current.productId,
                price: current.price,
                image: current.image,
                sugar: selectedSugar,
                size: selectedSize
            });
        }
        closeDetail();
    });

    // Lọc danh mục Client-side
    const categoryBtns = document.querySelectorAll('.category-btn');
    const productCards = document.querySelectorAll('.product-card');
    let activeCategoryId = null;

    categoryBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            const categoryId = btn.dataset.categoryId;
            if (activeCategoryId === categoryId) {
                // Hủy chọn, hiện lại tất cả
                activeCategoryId = null;
                categoryBtns.forEach(b => {
                    b.className = "category-btn whitespace-nowrap rounded-full border border-outline bg-surface px-6 py-2 font-label-md text-primary transition-soft hover:bg-secondary-container";
                });
                productCards.forEach(c => c.classList.remove('hidden'));
            } else {
                activeCategoryId = categoryId;
                categoryBtns.forEach(b => {
                    if (b === btn) {
                        b.className = "category-btn whitespace-nowrap rounded-full bg-primary px-6 py-2 font-label-md text-on-primary transition-soft";
                    } else {
                        b.className = "category-btn whitespace-nowrap rounded-full border border-outline bg-surface px-6 py-2 font-label-md text-primary transition-soft hover:bg-secondary-container";
                    }
                });
                productCards.forEach(c => {
                    if (c.dataset.categoryId === categoryId) {
                        c.classList.remove('hidden');
                    } else {
                        c.classList.add('hidden');
                    }
                });
            }
        });
    });

    // Xử lý sự kiện Checkout (đặt hàng) giảm Stock ở database
    document.getElementById('checkoutBtn').addEventListener('click', async () => {
        const cart = getCart();
        if (!cart.length) {
            showCheckoutNotice({
                title: "Giỏ hàng đang trống",
                message: "Bạn hãy thêm sản phẩm Coffe vào giỏ hàng trước khi mua nhé.",
                type: "error"
            });
            return;
        }

        try {
            if (!isAuthenticated) {
                window.location.href = '/Account/Login?returnUrl=' + encodeURIComponent('/Product/Index');
                return;
            }

            const response = await fetch('/Product/Checkout', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    items: cart.map(item => ({
                        productId: item.productId,
                        name: item.name,
                        qty: item.qty,
                        sugar: item.sugar,
                        size: item.size
                    }))
                })
            });

            if (response.status === 401) {
                window.location.href = '/Account/Login?returnUrl=' + encodeURIComponent('/Product/Index');
                return;
            }

            const result = await response.json();
            if (response.ok && result.success) {
                const purchasedNames = cart
                    .map(item => item.name)
                    .filter((name, index, names) => names.indexOf(name) === index)
                    .slice(0, 3)
                    .join(", ");
                clearCart();
                closeCart();
                showCheckoutNotice({
                    title: "Đã mua sản phẩm Coffe",
                    message: `Cảm ơn bạn đã mua ${purchasedNames || "sản phẩm"} tại Coffe Latte Kawaii. Đơn hàng của bạn đã được lưu vào lịch sử mua hàng.`,
                    type: "success"
                });
            } else {
                showCheckoutNotice({
                    title: "Đặt hàng chưa thành công",
                    message: result.message || "Vui lòng thử lại sau ít phút.",
                    type: "error"
                });
            }
        } catch (error) {
            console.error("Lỗi đặt hàng:", error);
            showCheckoutNotice({
                title: "Không kết nối được máy chủ",
                message: "Có lỗi xảy ra khi đặt hàng. Vui lòng thử lại nhé.",
                type: "error"
            });
        }
    });

    renderCart();
    @if (TempData["RegisterNotice"] is string registerNotice)
    {
        <text>
        showCheckoutNotice({
            title: "Đăng ký thành công",
            message: @Json.Serialize(registerNotice),
            type: "success"
        });
        </text>
    }
})();
</script>
}


