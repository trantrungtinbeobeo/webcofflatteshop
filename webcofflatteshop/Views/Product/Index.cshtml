@model IEnumerable<webcofflatteshop.Models.Product>
@using System.Globalization
@{
    ViewData["Title"] = "Menu";
    var banners = (ViewBag.Banners as IEnumerable<string> ?? new[] { "/images/default-coffee.svg" }).ToList();
    var promoBanner = ViewBag.PromoBanner as webcofflatteshop.Models.PromoBannerSettings ?? new webcofflatteshop.Models.PromoBannerSettings();
    var promoImages = (promoBanner.ImageUrls ?? new List<string>())
        .Where(image => !string.IsNullOrWhiteSpace(image))
        .ToList();
    if (!promoImages.Any() && !string.IsNullOrWhiteSpace(promoBanner.ImageUrl))
    {
        promoImages.Add(promoBanner.ImageUrl);
    }
    var showPromoBanner = promoBanner.IsEnabled && promoImages.Any();
    var products = Model.Where(product => product.IsAvailable).ToList();
    var categories = products
        .Where(product => product.Category is not null)
        .GroupBy(product => new { product.CategoryId, product.Category!.Name })
        .Select(group => group.Key)
        .OrderBy(category => category.CategoryId)
        .ToList();
    var productPrices = products.ToDictionary(product => product.Name, product => product.Price);
    var productPricesById = products.ToDictionary(product => product.Id, product => product.Price);
    var productStocksById = products.ToDictionary(product => product.Id, product => product.Stock);
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var fallbackImages = new[]
    {
        "https://lh3.googleusercontent.com/aida-public/AB6AXuABrBSS4LFPWVxIKu6AbEOBxgmUwSbQskURn4aCXn9wvyYRgRi0pnxTtP-LHTYrgu1yclJXfBa3zIb0vsbsBhlIfRaaqMhCwzQrAcRjKji5bp9ZzzXZoNjDNXhXDm5SixoY_llnZyqHmXEsGE0JDLyqGPwlAbLiDEGIIzdsRPuaX7nAgUkQe1vdiIzmUYlUf0Mku2urg6oHg2juQMP1nvU0fvrVPgR-WKWZlurqxB10q5yY04_MRfSMBajShMrmrH6vNtKAFL-kYUk",
