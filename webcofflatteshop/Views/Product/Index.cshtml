    };
    var heroBanners = banners.Where(banner => !string.IsNullOrWhiteSpace(banner)).ToList();
    if (!heroBanners.Any())
    {
        heroBanners.Add("https://lh3.googleusercontent.com/aida-public/AB6AXuCYz6au7BPWgtSSBFiSZJVjAly8L00XGdg-tPC4829OE-DiHnKyKeSY6Mpr26uJoVFOx85UdexJd1d_f9NDIDLMgzO7koTOcWG6FRVJ-OVuTowfYg8k3u2Tp_uyWppOLMczAyclalIUQtggbC15NjCar30VXcyHovsL6YnJSPZIwk2FyHa5CzvUX4qe5cxy2HOC6SWqB7Oys46JRkS7e_o2dt8jPgAGTcwq3ONsQVlR-2338Ikw0xTyKzPDMKNG7dl33GDc4iNo8SE");
    }
    string ImageOf(webcofflatteshop.Models.Product product, int index) => string.IsNullOrWhiteSpace(product.ImageUrl) ? fallbackImages[index % fallbackImages.Length] : product.ImageUrl;
    bool HasPromo(webcofflatteshop.Models.Product product) => promoBanner.IsEnabled && promoBanner.ProductId == product.Id && promoBanner.DiscountPercent > 0;
    decimal PromoPrice(decimal price) => Math.Max(decimal.Round(price * (100 - Math.Clamp(promoBanner.DiscountPercent, 0, 100)) / 100, 0), 0);
    string IconOf(string name)
    {
        var lower = name.ToLowerInvariant();
        if (lower.Contains("matcha") || lower.Contains("trà") || lower.Contains("tea")) return "energy_savings_leaf";
        if (lower.Contains("bánh") || lower.Contains("cake")) return "cake";
        if (lower.Contains("croissant")) return "bakery_dining";
        if (lower.Contains("espresso")) return "bolt";
        if (lower.Contains("atiso") || lower.Contains("ice")) return "icecream";
        return "coffee";
    }
}

<style>
    @@keyframes checkout-pop {
        0% { opacity: 0; transform: translateY(18px) scale(0.92); }
        70% { opacity: 1; transform: translateY(0) scale(1.04); }
        100% { opacity: 1; transform: translateY(0) scale(1); }
    }

    @@keyframes checkout-check {
        0% { stroke-dashoffset: 48; }
        100% { stroke-dashoffset: 0; }
    }

    .checkout-notice-show {
        animation: checkout-pop 360ms ease-out both;
    }

    .checkout-check-path {
        stroke-dasharray: 48;
        stroke-dashoffset: 48;
        animation: checkout-check 520ms ease-out 160ms forwards;
    }
</style>

<nav class="sticky top-0 z-50 bg-surface shadow-[0_10px_30px_rgba(62,39,35,0.05)]">
    <div class="mx-auto flex w-full max-w-container-max items-center justify-between px-margin-mobile py-unit md:px-margin-desktop">
        <a asp-controller="Product" asp-action="Index" class="flex items-center gap-3">
            <partial name="_SakuraLogoMark" />
            <h1 class="font-['Noto_Serif'] text-[32px] font-bold leading-none">
                <span style="color:#3e2723">Coffe</span><span style="color:#81c784">-latte</span><span style="color:#f48fb1">Kawaii</span>
            </h1>
        </a>
        <div class="hidden items-center gap-gutter md:flex">
            <a class="font-body-md border-b-2 border-primary pb-1 text-primary" href="#menu">Menu</a>
            @if (User.IsInRole("Admin"))
            {
                <a class="font-body-md text-secondary transition-colors duration-200 hover:text-primary" asp-controller="Product" asp-action="Add">Manager</a>
            }
        </div>
        <div class="flex items-center gap-unit">
            @if (isAuthenticated)
            {
                <partial name="_UserAvatarHeader" />
                <a asp-controller="Account" asp-action="Profile" class="rounded-lg px-3 py-2 font-label-md text-primary transition-colors hover:bg-secondary-container">Trang cá nhân</a>
                <a asp-controller="Account" asp-action="PurchaseHistory" class="rounded-lg px-3 py-2 font-label-md text-primary transition-colors hover:bg-secondary-container">Lịch sử đơn hàng</a>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="rounded-lg px-3 py-2 font-label-md text-primary transition-colors hover:bg-secondary-container">Đăng xuất</button>
                </form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="rounded-lg px-3 py-2 font-label-md text-primary transition-colors hover:bg-secondary-container">Đăng nhập</a>
            }
            <button class="relative rounded-full p-2 text-primary transition-colors hover:bg-secondary-container" onclick="toggleCart()" aria-label="Mở giỏ hàng">
                <span class="material-symbols-outlined">shopping_cart</span>
                <span id="cartCount" class="absolute right-0 top-0 flex h-4 w-4 items-center justify-center rounded-full bg-primary text-[10px] text-white">0</span>
            </button>
            <button class="p-2 text-primary md:hidden" aria-label="Menu">
                <span class="material-symbols-outlined">menu</span>
            </button>
        </div>
    </div>
</nav>

<div id="cartBackdrop" class="fixed inset-0 z-[55] hidden bg-primary/30 backdrop-blur-sm" onclick="closeCart()"></div>

<div id="cartDrawer" class="fixed right-0 top-0 z-[60] flex h-full w-full translate-x-full flex-col bg-surface-container-lowest shadow-2xl transition-transform duration-300 lg:w-[400px]">
    <div class="flex items-center justify-between border-b border-outline-variant p-gutter">
        <div>
            <h2 class="font-headline-md text-headline-md text-primary">Giỏ hàng của bạn</h2>
            <p class="font-caption text-caption text-secondary">Những món Coffe đã chọn</p>
        </div>
        <button class="rounded-full p-2 hover:bg-surface-container" onclick="closeCart()" aria-label="Đóng giỏ hàng">
            <span class="material-symbols-outlined">close</span>
        </button>
    </div>
    <div id="cartItems" class="flex-grow space-y-gutter overflow-y-auto p-gutter"></div>
    <div class="space-y-4 border-t border-outline-variant bg-surface-container p-gutter">
        <div class="flex justify-between font-label-md text-label-md text-primary">
            <span>Tạm tính</span>
            <span id="cartSubtotal">0 VNĐ</span>
        </div>
        <button id="checkoutBtn" class="flex w-full items-center justify-between rounded-lg bg-primary px-6 py-4 font-label-md text-on-primary transition-soft hover:brightness-110">
            <span>Mua hàng</span>
            <span class="material-symbols-outlined">arrow_forward</span>
        </button>
        <button id="clearCartBtn" class="flex w-full items-center justify-center gap-2 rounded-lg border border-outline-variant px-6 py-3 font-label-md text-secondary transition-soft hover:bg-surface-container-high hover:text-error">
            <span class="material-symbols-outlined text-[18px]">delete</span>
            <span>Xóa hết giỏ hàng</span>
        </button>
    </div>
</div>

<div id="checkoutNotice" class="fixed inset-0 z-[90] hidden items-center justify-center bg-primary/35 px-margin-mobile backdrop-blur-sm">
    <div id="checkoutNoticeCard" class="w-full max-w-lg rounded-2xl border border-outline-variant/20 bg-surface-container-lowest p-gutter text-center shadow-2xl">
        <div id="checkoutNoticeIconWrap" class="mx-auto mb-5 flex h-20 w-20 items-center justify-center rounded-full bg-[#e8f5e9] text-[#2e7d32]">
            <svg class="h-12 w-12" viewBox="0 0 52 52" aria-hidden="true">
                <circle cx="26" cy="26" r="23" fill="none" stroke="currentColor" stroke-width="3" opacity=".22"></circle>
                <path class="checkout-check-path" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="5" d="M15 27.5 22.5 35 38 18"></path>
            </svg>
        </div>
        <h2 id="checkoutNoticeTitle" class="mb-2 font-headline-md text-headline-md text-primary">Đã mua sản phẩm Coffe</h2>
        <p id="checkoutNoticeMessage" class="font-body-md text-secondary">Cảm ơn bạn đã mua hàng tại Coffe Latte Kawaii.</p>
        <button id="checkoutNoticeClose" type="button" class="mt-6 rounded-lg bg-primary px-6 py-3 font-label-md text-on-primary transition hover:brightness-110">Tiếp tục mua hàng</button>
    </div>
</div>

<div id="checkoutConfirm" class="fixed inset-0 z-[88] hidden items-center justify-center bg-primary/35 px-margin-mobile backdrop-blur-sm">
    <div class="w-full max-w-xl rounded-2xl border border-outline-variant/20 bg-surface-container-lowest p-gutter shadow-2xl">
        <div class="mb-5 flex items-center justify-center gap-3 text-center">
            <partial name="_SakuraLogoMark" />
            <div>
                <p class="font-['Noto_Serif'] text-[26px] font-bold leading-none text-primary">Coffe-latteKawaii</p>
                <p class="mt-1 text-caption text-secondary">Xác nhận đơn hàng</p>
            </div>
        </div>
        <div id="checkoutConfirmItems" class="max-h-56 space-y-3 overflow-y-auto rounded-xl bg-surface-container-low p-4"></div>
        <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
            <label class="checkout-method rounded-xl border border-primary bg-secondary-container p-4 text-primary">
                <input type="radio" name="fulfillmentMethod" value="Pickup" class="mr-2 text-primary" checked />
                <span class="font-label-md">Nhận tại cửa hàng</span>
                <span class="mt-1 block text-caption text-secondary">Không tính phí ship.</span>
            </label>
            <label class="checkout-method rounded-xl border border-outline-variant bg-white p-4 text-primary">
                <input type="radio" name="fulfillmentMethod" value="Delivery" class="mr-2 text-primary" />
                <span class="font-label-md">Giao tận nhà 1km</span>
                <span class="mt-1 block text-caption text-secondary">Phí ship 15.000 VNĐ.</span>
            </label>
        </div>
        <div class="mt-5 space-y-2 rounded-xl bg-surface-container-low p-4">
            <div class="flex justify-between text-body-md text-secondary"><span>Tạm tính</span><span id="confirmSubtotal">0 VNĐ</span></div>
            <div class="flex justify-between text-body-md text-secondary"><span>Phí ship</span><span id="confirmShipping">0 VNĐ</span></div>
            <div class="flex justify-between font-headline-md text-primary"><span>Tổng cộng</span><span id="confirmTotal">0 VNĐ</span></div>
        </div>
        <div class="mt-5 grid grid-cols-2 gap-3">
            <button id="checkoutCancel" type="button" class="rounded-lg border border-outline-variant px-4 py-3 font-label-md text-secondary hover:bg-surface-container">Hủy</button>
            <button id="checkoutConfirmBtn" type="button" class="rounded-lg bg-primary px-4 py-3 font-label-md text-on-primary hover:brightness-110">Xác nhận</button>
        </div>
    </div>
</div>

<main class="mx-auto max-w-container-max px-margin-mobile py-gutter md:px-margin-desktop">
    <section id="heroCarousel" class="group relative mb-section-gap h-[400px] overflow-hidden rounded-xl" data-interval="5000">
        <div class="relative h-full overflow-hidden">
            @for (var bannerIndex = 0; bannerIndex < heroBanners.Count; bannerIndex++)
            {
                <img class="hero-slide absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-700 @(bannerIndex == 0 ? "is-active opacity-100" : "")" src="@heroBanners[bannerIndex]" alt="Banner Coffe Latte Kawaii @(bannerIndex + 1)" data-slide-index="@bannerIndex" loading="@(bannerIndex == 0 ? "eager" : "lazy")" decoding="async" fetchpriority="@(bannerIndex == 0 ? "high" : "low")" />
            }
            <div class="hero-gradient pointer-events-none absolute inset-0 flex items-end p-gutter">
                <div class="max-w-xl text-white">
                    <h1 class="mb-4 font-display-lg text-display-lg">Hương Vị Nghệ Thuật</h1>
                    <p class="font-body-lg text-body-lg opacity-90">Sự kết hợp hoàn hảo giữa tâm hồn Sài Gòn và hơi thở cố đô Kyoto.</p>
                </div>
            </div>
        </div>
        @if (heroBanners.Count > 1)
        {
            <button type="button" class="hero-arrow absolute left-4 top-1/2 flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded-full bg-white/25 text-white opacity-45 backdrop-blur-md transition hover:bg-white/40 hover:opacity-90" data-carousel-prev aria-label="Banner trước">
                <span class="material-symbols-outlined text-[22px]">chevron_left</span>
            </button>
            <button type="button" class="hero-arrow absolute right-4 top-1/2 flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded-full bg-white/25 text-white opacity-45 backdrop-blur-md transition hover:bg-white/40 hover:opacity-90" data-carousel-next aria-label="Banner tiếp theo">
                <span class="material-symbols-outlined text-[22px]">chevron_right</span>
            </button>
            <div class="absolute bottom-4 left-1/2 flex -translate-x-1/2 items-center gap-2">
                @for (var bannerIndex = 0; bannerIndex < heroBanners.Count; bannerIndex++)
                {
                    <button type="button" class="hero-dot h-2.5 w-2.5 rounded-full bg-white/45 transition-all @(bannerIndex == 0 ? "w-7 bg-white/90" : "")" data-carousel-dot="@bannerIndex" aria-label="Chuyển đến banner @(bannerIndex + 1)"></button>
                }
            </div>
        }
    </section>

    <section class="hide-scrollbar mb-gutter flex gap-4 overflow-x-auto py-2">
        <button class="category-btn whitespace-nowrap rounded-full bg-primary px-6 py-2 font-label-md text-on-primary transition-soft" data-category-id="all">Tất cả</button>
        @foreach (var category in categories)
        {
            <button class="category-btn whitespace-nowrap rounded-full border border-outline bg-surface px-6 py-2 font-label-md text-primary transition-soft hover:bg-secondary-container" data-category-id="@category.CategoryId">@category.Name</button>
        }
    </section>

    <section class="relative">
        <div id="menu" class="grid grid-cols-1 gap-gutter md:grid-cols-2 lg:grid-cols-3">
            @for (var index = 0; index < products.Count; index++)
            {
                var product = products[index];
                var imageUrl = ImageOf(product, index);
                var hasPromo = HasPromo(product);
                var promoPrice = hasPromo ? PromoPrice(product.Price) : product.Price;
                <article class="product-card render-list-item group overflow-hidden rounded-xl bg-surface-container-lowest shadow-[0_10px_30px_rgba(62,39,35,0.05)] transition-soft hover:-translate-y-1 hover:shadow-xl" data-product-id="@product.Id" data-category-id="@product.CategoryId">
                    <button type="button" class="js-open-detail block w-full text-left" data-product-id="@product.Id" data-name="@product.Name" data-description="@product.Description" data-price="@product.Price.ToString(CultureInfo.InvariantCulture)" data-stock="@product.Stock" data-discount-percent="@(hasPromo ? promoBanner.DiscountPercent : 0)" data-display-price="@product.Price.ToString("N0") VNĐ" data-image="@imageUrl">
                        <div class="relative aspect-square cursor-pointer overflow-hidden">
                            <img data-product-image class="h-full w-full object-cover transition-soft group-hover:scale-105" src="@imageUrl" alt="@product.Name" loading="lazy" decoding="async" fetchpriority="low" />
                            <div class="absolute right-4 top-4 rounded-full bg-white/80 p-2 backdrop-blur-md">
                                <span class="material-symbols-outlined text-primary">@IconOf(product.Name)</span>
                            </div>
                            @if (hasPromo)
                            {
                                <div class="absolute left-4 top-4 rounded-full bg-tertiary-fixed px-3 py-1 text-caption font-bold text-on-tertiary-fixed">-@promoBanner.DiscountPercent%</div>
                            }
                        </div>
                        <div class="p-gutter">
                            <h3 data-product-name class="mb-1 font-headline-md text-headline-md text-primary">@product.Name</h3>
                            <p data-product-description class="mb-4 line-clamp-2 font-body-md text-secondary">@product.Description</p>
                            <div class="flex items-center justify-between gap-3">
                                <span data-product-price class="font-label-md text-on-tertiary-container">
                                    @if (hasPromo)
                                    {
                                        <span class="block text-[12px] leading-4 text-secondary line-through">@product.Price.ToString("N0") VNĐ</span>
                                        <span class="flex items-center gap-2 text-base leading-5">
                                            @promoPrice.ToString("N0") VNĐ
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-lg">@product.Price.ToString("N0") VNĐ</span>
                                    }
                                </span>
                                <span class="rounded-lg bg-primary px-4 py-2 font-label-md text-on-primary transition-soft hover:brightness-125">Thêm vào giỏ</span>
                            </div>
                        </div>
                    </button>
                </article>
            }
        </div>
        @if (showPromoBanner)
        {
            <aside class="pointer-events-auto fixed right-4 top-1/2 z-40 hidden w-36 -translate-y-1/2 lg:block xl:w-40">
                <div id="promoCarousel" class="relative overflow-hidden rounded-xl border border-outline-variant/20 bg-surface-container-lowest shadow-[0_10px_30px_rgba(62,39,35,0.08)]" data-interval="5000">
                    @if (!string.IsNullOrWhiteSpace(promoBanner.LinkUrl))
                    {
                        <a href="@promoBanner.LinkUrl" class="block">
                            <div class="relative h-[520px] overflow-hidden">
                                @for (var promoIndex = 0; promoIndex < promoImages.Count; promoIndex++)
                                {
                                    <img src="@promoImages[promoIndex]" alt="@promoBanner.Title" class="promo-slide absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-700 @(promoIndex == 0 ? "opacity-100" : "")" loading="lazy" decoding="async" fetchpriority="low" />
                                }
                            </div>
                        </a>
                    }
                    else
                    {
                        <div class="relative h-[520px] overflow-hidden">
                            @for (var promoIndex = 0; promoIndex < promoImages.Count; promoIndex++)
                            {
                                <img src="@promoImages[promoIndex]" alt="@promoBanner.Title" class="promo-slide absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-700 @(promoIndex == 0 ? "opacity-100" : "")" loading="lazy" decoding="async" fetchpriority="low" />
                            }
                        </div>
                    }
                    @if (promoImages.Count > 1)
                    {
                        <div class="absolute left-1/2 top-[492px] z-10 flex -translate-x-1/2 items-center gap-1 rounded-full bg-primary/20 px-1.5 py-1 backdrop-blur-sm">
                            @for (var promoIndex = 0; promoIndex < promoImages.Count; promoIndex++)
                            {
                                <span class="promo-dot h-1.5 w-1.5 rounded-full bg-white/50 @(promoIndex == 0 ? "bg-white/90" : "")"></span>
                            }
                        </div>
                    }
                    <div class="space-y-2 p-2.5">
                        <div class="flex items-center gap-1 text-[10px] font-bold uppercase tracking-widest text-secondary">
                            <span class="material-symbols-outlined text-[16px]">local_offer</span>
                            Khuyến mãi
                        </div>
                        <div class="space-y-2">
                            <h2 class="font-headline-md text-[16px] leading-5 text-primary">@promoBanner.Title</h2>
                            <span class="inline-flex rounded-full bg-tertiary-fixed px-2 py-1 text-[11px] font-bold text-on-tertiary-fixed">
                                @(promoBanner.DiscountPercent > 0 ? $"-{promoBanner.DiscountPercent}%" : "Ưu đãi")
                            </span>
                        </div>
                        <p class="text-[11px] leading-4 text-secondary">@promoBanner.Description</p>
                    </div>
                </div>
            </aside>
        }
    </section>
</main>

<div id="detailModal" class="fixed inset-0 z-[70] hidden items-center justify-center p-margin-mobile">
    <div class="absolute inset-0 bg-primary/40 backdrop-blur-sm" onclick="closeDetail()"></div>
    <div id="modalContent" class="relative flex w-full max-w-4xl scale-95 flex-col overflow-hidden rounded-2xl bg-surface shadow-2xl transition-transform duration-300 md:flex-row">
        <div class="h-64 overflow-hidden md:h-auto md:w-1/2">
            <img id="detailImg" class="h-full w-full object-cover" src="/images/default-coffee.svg" alt="Product detail" />
        </div>
        <div class="flex flex-col justify-between p-gutter md:w-1/2">
            <div>
                <div class="mb-4 flex items-start justify-between">
                    <h2 id="detailTitle" class="font-display-lg text-headline-lg text-primary">Product Name</h2>
                    <button class="rounded-full p-2 hover:bg-surface-container" onclick="closeDetail()">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                </div>
                <p id="detailDesc" class="mb-6 font-body-lg text-secondary">Món quà từ thiên nhiên với quy trình chế biến thủ công.</p>
                <div class="mb-8 space-y-4">
                    <div>
                        <span class="mb-2 block font-label-md text-primary">Tùy chọn đường</span>
                        <div class="flex gap-2">
                            <button class="sugar-option-btn rounded-full border border-primary bg-primary px-4 py-1 font-caption text-on-primary" data-sugar="100%">100%</button>
                            <button class="sugar-option-btn rounded-full border border-outline px-4 py-1 font-caption text-secondary" data-sugar="50%">50%</button>
                            <button class="sugar-option-btn rounded-full border border-outline px-4 py-1 font-caption text-secondary" data-sugar="Không đường">Không đường</button>
                        </div>
                    </div>
                    <div>
                        <span class="mb-2 block font-label-md text-primary">Kích cỡ</span>
                        <div class="flex gap-2">
                            <button class="size-option-btn rounded-full border border-outline px-4 py-1 font-caption text-secondary" data-size="Nhỏ">Nhỏ</button>
                            <button class="size-option-btn rounded-full border border-primary bg-primary px-4 py-1 font-caption text-on-primary" data-size="Vừa">Vừa</button>
                            <button class="size-option-btn rounded-full border border-outline px-4 py-1 font-caption text-secondary" data-size="Lớn">Lớn</button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="flex items-center gap-4">
                <div id="detailPrice" class="font-headline-md text-primary">45.000 VNĐ</div>
                <button id="detailAddBtn" class="flex-grow rounded-xl bg-primary py-4 font-label-md text-on-primary transition-soft hover:shadow-lg">Thêm vào giỏ hàng</button>
            </div>
        </div>
    </div>
</div>

<footer id="story" class="mt-section-gap flex w-full flex-col items-center gap-gutter bg-surface-container px-margin-mobile py-section-gap md:px-margin-desktop">
    <div class="flex items-center gap-3">
        <partial name="_SakuraLogoMark" />
        <span class="font-['Noto_Serif'] text-[32px] font-bold leading-none">
            <span style="color:#3e2723">Coffe</span><span style="color:#81c784">-latte</span><span style="color:#f48fb1">Kawaii</span>
        </span>
    </div>
    <div class="flex flex-wrap justify-center gap-gutter text-secondary">
        <a class="transition-colors hover:text-on-tertiary-container" href="#">Privacy Policy</a>
        <a class="transition-colors hover:text-on-tertiary-container" href="#">Terms of Service</a>
        <a class="transition-colors hover:text-on-tertiary-container" href="#">Shipping Info</a>
        <a class="transition-colors hover:text-on-tertiary-container" href="#">Contact Us</a>
    </div>
    <p class="font-body-md text-body-md text-secondary opacity-70">© 2026 Coffe Latte Kawaii. A Saigon-Kyoto Fusion.</p>
</footer>

@section Scripts {
<script>
(() => {
    const heroCarousel = document.getElementById('heroCarousel');
    if (heroCarousel) {
        const slides = Array.from(heroCarousel.querySelectorAll('.hero-slide'));
        const dots = Array.from(heroCarousel.querySelectorAll('.hero-dot'));
        const prevButton = heroCarousel.querySelector('[data-carousel-prev]');
        const nextButton = heroCarousel.querySelector('[data-carousel-next]');
        const intervalMs = Number(heroCarousel.dataset.interval || 5000);
        let activeSlide = 0;
        let carouselTimer = null;

        const showSlide = index => {
            if (!slides.length) return;

            activeSlide = (index + slides.length) % slides.length;
            slides.forEach((slide, slideIndex) => {
                const isActive = slideIndex === activeSlide;
                slide.classList.toggle('opacity-100', isActive);
                slide.classList.toggle('opacity-0', !isActive);
                slide.classList.toggle('is-active', isActive);
            });
            dots.forEach((dot, dotIndex) => {
                const isActive = dotIndex === activeSlide;
                dot.classList.toggle('w-7', isActive);
                dot.classList.toggle('bg-white/90', isActive);
                dot.classList.toggle('bg-white/45', !isActive);
            });
        };

        const restartCarousel = () => {
            if (carouselTimer) window.clearInterval(carouselTimer);
            if (slides.length <= 1) return;

            carouselTimer = window.setInterval(() => {
                showSlide(activeSlide + 1);
            }, intervalMs);
        };

        prevButton?.addEventListener('click', () => {
            showSlide(activeSlide - 1);
            restartCarousel();
        });
        nextButton?.addEventListener('click', () => {
            showSlide(activeSlide + 1);
            restartCarousel();
        });
        dots.forEach(dot => {
            dot.addEventListener('click', () => {
                showSlide(Number(dot.dataset.carouselDot));
                restartCarousel();
            });
        });

        showSlide(0);
        restartCarousel();
    }

    const promoCarousel = document.getElementById('promoCarousel');
    if (promoCarousel) {
        const slides = Array.from(promoCarousel.querySelectorAll('.promo-slide'));
        const dots = Array.from(promoCarousel.querySelectorAll('.promo-dot'));
        let activePromoSlide = 0;
        const showPromoSlide = index => {
            if (!slides.length) return;
            activePromoSlide = (index + slides.length) % slides.length;
            slides.forEach((slide, slideIndex) => {
                const isActive = slideIndex === activePromoSlide;
                slide.classList.toggle('opacity-100', isActive);
                slide.classList.toggle('opacity-0', !isActive);
            });
            dots.forEach((dot, dotIndex) => {
                const isActive = dotIndex === activePromoSlide;
                dot.classList.toggle('bg-white/90', isActive);
                dot.classList.toggle('bg-white/50', !isActive);
            });
        };
        if (slides.length > 1) {
            window.setInterval(() => showPromoSlide(activePromoSlide + 1), Number(promoCarousel.dataset.interval || 5000));
        }
        showPromoSlide(0);
    }

    const productPrices = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(productPrices));
    const productPricesById = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(productPricesById));
    const productStocksById = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(productStocksById));
    const promoPricing = {
        productId: @Json.Serialize(promoBanner.IsEnabled && promoBanner.DiscountPercent > 0 ? promoBanner.ProductId : null),
        discountPercent: @Json.Serialize(Math.Clamp(promoBanner.DiscountPercent, 0, 100))
    };
    const shippingFee = 15000;
    const isAuthenticated = @Json.Serialize(isAuthenticated);
    const escapeHtml = value => String(value ?? '')
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;');
    const toNumber = value => {
        if (typeof value === 'number') return Number.isFinite(value) ? value : 0;

        const raw = String(value ?? '').trim();
        const normalized = raw.includes(',')
            ? raw.replace(/\./g, '').replace(',', '.')
            : /^\d{1,3}(\.\d{3})+$/.test(raw)
                ? raw.replace(/\./g, '')
                : raw;
        const parsed = Number(normalized);
        return Number.isFinite(parsed) ? parsed : 0;
    };
    const formatCurrency = value => `${toNumber(value).toLocaleString('vi-VN')} VNĐ`;
    const originalPriceForCartItem = item => {
        let repairedPrice = toNumber(productPricesById[item.productId] ?? productPrices[String(item.productId)] ?? productPrices[item.name]);
        if (item.size === 'Nhỏ') repairedPrice -= 5000;
        else if (item.size === 'Lớn') repairedPrice += 10000;

        return Math.max(repairedPrice, 0);
    };
    const isPromoCartItem = item => promoPricing.productId && Number(item.productId) === Number(promoPricing.productId) && promoPricing.discountPercent > 0;
    const priceForCartItem = item => {
        const originalPrice = originalPriceForCartItem(item);
        if (originalPrice > 0 && isPromoCartItem(item)) {
            return Math.max(Math.round(originalPrice * (100 - promoPricing.discountPercent) / 100), 0);
        }
        if (originalPrice > 0) return originalPrice;

        const currentPrice = toNumber(item.price);
        if (currentPrice > 0) return currentPrice;

        return 0;
    };
    const normalizeCart = cart => cart.map(item => ({
        ...item,
        qty: Number.isFinite(Number(item.qty)) && Number(item.qty) > 0 ? Number(item.qty) : 1,
        stock: Number.isFinite(Number(item.stock))
            ? Number(item.stock)
            : Number.isFinite(Number(productStocksById[item.productId]))
                ? Number(productStocksById[item.productId])
                : null,
        originalPrice: originalPriceForCartItem(item),
        discountPercent: isPromoCartItem(item) ? promoPricing.discountPercent : 0,
        price: priceForCartItem(item)
    }));
    const getCart = () => normalizeCart(JSON.parse(localStorage.getItem('coffee_cart') || '[]'));
    const setCart = value => localStorage.setItem('coffee_cart', JSON.stringify(value));
    const cartDrawer = document.getElementById('cartDrawer');
    const cartBackdrop = document.getElementById('cartBackdrop');
    const cartCount = document.getElementById('cartCount');
    const cartItems = document.getElementById('cartItems');
    const cartSubtotal = document.getElementById('cartSubtotal');
    const clearCartBtn = document.getElementById('clearCartBtn');
    const checkoutNotice = document.getElementById('checkoutNotice');
    const checkoutNoticeCard = document.getElementById('checkoutNoticeCard');
    const checkoutNoticeTitle = document.getElementById('checkoutNoticeTitle');
    const checkoutNoticeMessage = document.getElementById('checkoutNoticeMessage');
    const checkoutNoticeIconWrap = document.getElementById('checkoutNoticeIconWrap');
    const checkoutNoticeClose = document.getElementById('checkoutNoticeClose');
    const checkoutConfirm = document.getElementById('checkoutConfirm');
    const checkoutConfirmItems = document.getElementById('checkoutConfirmItems');
    const checkoutCancel = document.getElementById('checkoutCancel');
    const checkoutConfirmBtn = document.getElementById('checkoutConfirmBtn');
    const confirmSubtotal = document.getElementById('confirmSubtotal');
    const confirmShipping = document.getElementById('confirmShipping');
    const confirmTotal = document.getElementById('confirmTotal');
    let current = null;
    let selectedSugar = "100%";
    let selectedSize = "Vừa";

    const openCart = () => {
        cartDrawer.classList.remove('translate-x-full');
        cartBackdrop.classList.remove('hidden');
    };
    window.closeCart = () => {
        cartDrawer.classList.add('translate-x-full');
        cartBackdrop.classList.add('hidden');
    };
    window.toggleCart = () => {
        if (cartDrawer.classList.contains('translate-x-full')) openCart();
        else closeCart();
    };
    window.closeDetail = () => {
        document.getElementById('detailModal').classList.add('hidden');
        document.getElementById('detailModal').classList.remove('flex');
    };

    const renderCart = () => {
        const cart = getCart();
        cartCount.textContent = cart.reduce((sum, item) => sum + item.qty, 0);
        cartSubtotal.textContent = formatCurrency(cart.reduce((sum, item) => sum + item.price * item.qty, 0));
        cartItems.innerHTML = cart.length
            ? cart.map((item, index) => `
                <div class="render-list-compact flex gap-4 border-b border-outline-variant/10 pb-3">
                    <div class="h-20 w-20 flex-shrink-0 overflow-hidden rounded-lg">
                        <img class="h-full w-full object-cover" src="${item.image}" alt="${item.name}" loading="lazy" decoding="async">
                    </div>
                    <div class="flex-grow">
                        <div class="flex items-start justify-between gap-3">
                            <p class="font-label-md text-label-md text-primary font-semibold">${item.name}</p>
                            <button type="button" class="js-remove-cart-item rounded-full p-1 text-secondary transition-colors hover:bg-error-container hover:text-error" data-cart-index="${index}" aria-label="Xóa ${item.name} khỏi giỏ hàng">
                                <span class="material-symbols-outlined text-[18px]">delete</span>
                            </button>
                        </div>
                        <p class="text-[12px] text-secondary mt-0.5">Size: ${item.size} | Đường: ${item.sugar}</p>
                        <div class="mt-2 flex items-center justify-between gap-3">
                            <div class="flex items-center rounded-full border border-outline-variant bg-surface-container-lowest">
                                <button type="button" class="js-cart-qty rounded-l-full px-2 py-1 text-secondary transition-colors hover:bg-secondary-container hover:text-primary disabled:cursor-not-allowed disabled:opacity-40" data-cart-index="${index}" data-cart-delta="-1" ${item.qty <= 1 ? 'disabled' : ''} aria-label="Giảm số lượng ${item.name}">
                                    <span class="material-symbols-outlined text-[16px]">remove</span>
                                </button>
                                <span class="min-w-8 px-2 text-center text-caption font-bold text-primary">${item.qty}</span>
                                <button type="button" class="js-cart-qty rounded-r-full px-2 py-1 text-secondary transition-colors hover:bg-secondary-container hover:text-primary disabled:cursor-not-allowed disabled:opacity-40" data-cart-index="${index}" data-cart-delta="1" ${item.stock !== null && item.qty >= item.stock ? 'disabled' : ''} aria-label="Tăng số lượng ${item.name}">
                                    <span class="material-symbols-outlined text-[16px]">add</span>
                                </button>
                            </div>
                            <span class="text-right font-body-md text-primary font-medium">
                                ${item.discountPercent > 0
                                    ? `<span class="block text-[11px] text-secondary line-through">${formatCurrency(item.originalPrice * item.qty)}</span><span>${formatCurrency(item.price * item.qty)}</span>`
                                    : formatCurrency(item.price * item.qty)}
                            </span>
                        </div>
                    </div>
                </div>`).join('')
            : '<p class="font-body-md text-secondary">Chưa có sản phẩm nào.</p>';
    };

    const removeCartItem = index => {
        const cart = getCart();
        cart.splice(index, 1);
        setCart(cart);
        renderCart();
        syncCheckoutConfirm();
    };

    const updateCartQuantity = (index, delta) => {
        const cart = getCart();
        const item = cart[index];
        if (!item) return;

        const nextQty = Math.max(1, Number(item.qty || 1) + delta);
        if (item.stock !== null && nextQty > item.stock) {
            window.showAppToast?.('Tồn kho không đủ', `${item.name} hiện chỉ còn ${item.stock} sản phẩm.`);
            return;
        }

        item.qty = nextQty;
        setCart(cart);
        renderCart();
        syncCheckoutConfirm();
    };

    const clearCart = () => {
        localStorage.removeItem('coffee_cart');
        renderCart();
        syncCheckoutConfirm();
    };

    const addToCart = item => {
        if (item.stock !== null && Number(item.stock) <= 0) {
            window.showAppToast?.('Tạm hết hàng', `${item.name} hiện chưa còn sản phẩm để thêm vào giỏ.`);
            return;
        }

        const cart = getCart();
        const index = cart.findIndex(entry => entry.name === item.name && entry.sugar === item.sugar && entry.size === item.size);
        if (index >= 0) {
            const nextQty = cart[index].qty + 1;
            if (cart[index].stock !== null && nextQty > cart[index].stock) {
                window.showAppToast?.('Tồn kho không đủ', `${cart[index].name} hiện chỉ còn ${cart[index].stock} sản phẩm.`);
                openCart();
                return;
            }

            cart[index].qty = nextQty;
        }
        else cart.push({ ...item, qty: 1 });
        setCart(cart);
        renderCart();
        syncCheckoutConfirm();
        openCart();
    };

    const showCheckoutNotice = ({ title, message, type = 'success' }) => {
        checkoutNoticeTitle.textContent = title;
        checkoutNoticeMessage.textContent = message;
        checkoutNoticeIconWrap.className = type === 'success'
            ? 'mx-auto mb-5 flex h-20 w-20 items-center justify-center rounded-full bg-[#e8f5e9] text-[#2e7d32]'
            : 'mx-auto mb-5 flex h-20 w-20 items-center justify-center rounded-full bg-error-container text-error';
        checkoutNotice.classList.remove('hidden');
        checkoutNotice.classList.add('flex');
        checkoutNoticeCard.classList.remove('checkout-notice-show');
        void checkoutNoticeCard.offsetWidth;
        checkoutNoticeCard.classList.add('checkout-notice-show');
    };

    const hideCheckoutNotice = () => {
        checkoutNotice.classList.add('hidden');
        checkoutNotice.classList.remove('flex');
    };

    const selectedFulfillmentMethod = () => document.querySelector('input[name="fulfillmentMethod"]:checked')?.value || 'Pickup';
    const refreshCheckoutConfirmTotals = () => {
        const cart = getCart();
        const subtotal = cart.reduce((sum, item) => sum + item.price * item.qty, 0);
        const deliveryFee = selectedFulfillmentMethod() === 'Delivery' ? shippingFee : 0;
        confirmSubtotal.textContent = formatCurrency(subtotal);
        confirmShipping.textContent = formatCurrency(deliveryFee);
        confirmTotal.textContent = formatCurrency(subtotal + deliveryFee);
    };
    const openCheckoutConfirm = () => {
        const cart = getCart();
        checkoutConfirmItems.innerHTML = cart.map(item => `
            <div class="flex items-start justify-between gap-3 border-b border-outline-variant/20 pb-3 last:border-b-0 last:pb-0">
                <div>
                    <p class="font-label-md text-primary">${item.name}</p>
                    <p class="text-caption text-secondary">Size: ${item.size} | Đường: ${item.sugar} | x${item.qty}</p>
                </div>
                <div class="text-right font-label-md text-primary">
                    ${item.discountPercent > 0
                        ? `<span class="block text-[11px] text-secondary line-through">${formatCurrency(item.originalPrice * item.qty)}</span><span>${formatCurrency(item.price * item.qty)}</span>`
                        : formatCurrency(item.price * item.qty)}
                </div>
            </div>`).join('');
        refreshCheckoutConfirmTotals();
        checkoutConfirm.classList.remove('hidden');
        checkoutConfirm.classList.add('flex');
    };
    const closeCheckoutConfirm = () => {
        checkoutConfirm.classList.add('hidden');
        checkoutConfirm.classList.remove('flex');
    };
    const syncCheckoutConfirm = () => {
        if (checkoutConfirm.classList.contains('hidden')) return;
        if (!getCart().length) {
            closeCheckoutConfirm();
            return;
        }

        openCheckoutConfirm();
    };

    checkoutNoticeClose.addEventListener('click', hideCheckoutNotice);
    checkoutNotice.addEventListener('click', event => {
        if (event.target === checkoutNotice) hideCheckoutNotice();
    });
    checkoutCancel.addEventListener('click', closeCheckoutConfirm);
    checkoutConfirm.addEventListener('click', event => {
        if (event.target === checkoutConfirm) closeCheckoutConfirm();
    });
    document.querySelectorAll('input[name="fulfillmentMethod"]').forEach(input => {
        input.addEventListener('change', () => {
            document.querySelectorAll('.checkout-method').forEach(label => {
                const isActive = label.querySelector('input')?.checked;
                label.classList.toggle('border-primary', isActive);
                label.classList.toggle('bg-secondary-container', isActive);
                label.classList.toggle('bg-white', !isActive);
            });
            refreshCheckoutConfirmTotals();
        });
    });

    cartItems.addEventListener('click', event => {
        const removeButton = event.target.closest('.js-remove-cart-item');
        const qtyButton = event.target.closest('.js-cart-qty');
        if (qtyButton) {
            updateCartQuantity(Number(qtyButton.dataset.cartIndex), Number(qtyButton.dataset.cartDelta));
            return;
        }

        if (!removeButton) return;

        removeCartItem(Number(removeButton.dataset.cartIndex));
    });

    clearCartBtn.addEventListener('click', () => {
        if (!getCart().length) return;
        clearCart();
    });

    const bindProductDetailButton = button => {
        if (!button || button.dataset.detailBound === 'true') return;
        button.dataset.detailBound = 'true';
        button.addEventListener('click', () => {
            const basePrice = toNumber(button.dataset.price);
            current = { 
                productId: Number(button.dataset.productId),
                name: button.dataset.name, 
                basePrice: basePrice,
                stock: Number.isFinite(Number(button.dataset.stock)) ? Number(button.dataset.stock) : null,
                discountPercent: Math.max(0, Math.min(toNumber(button.dataset.discountPercent), 100)),
                price: basePrice, 
                image: button.dataset.image 
            };

            document.getElementById('detailTitle').textContent = button.dataset.name;
            document.getElementById('detailDesc').textContent = button.dataset.description || 'Món quà từ thiên nhiên với quy trình chế biến thủ công.';
            
            // Khởi tạo trạng thái mặc định
            selectedSugar = "100%";
            selectedSize = "Vừa";
            updateDetailPrice();

            // Reset classes cho Đường
            document.querySelectorAll('.sugar-option-btn').forEach(btn => {
                if (btn.dataset.sugar === "100%") {
                    btn.className = "sugar-option-btn rounded-full border border-primary bg-primary px-4 py-1 font-caption text-on-primary";
                } else {
                    btn.className = "sugar-option-btn rounded-full border border-outline px-4 py-1 font-caption text-secondary";
                }
            });

            // Reset classes cho Size
            document.querySelectorAll('.size-option-btn').forEach(btn => {
                if (btn.dataset.size === "Vừa") {
                    btn.className = "size-option-btn rounded-full border border-primary bg-primary px-4 py-1 font-caption text-on-primary";
                } else {
                    btn.className = "size-option-btn rounded-full border border-outline px-4 py-1 font-caption text-secondary";
                }
            });

            document.getElementById('detailImg').src = button.dataset.image;
            document.getElementById('detailModal').classList.remove('hidden');
            document.getElementById('detailModal').classList.add('flex');
        });
    };

    // Chi tiết sản phẩm & Lựa chọn thuộc tính
    document.querySelectorAll('.js-open-detail').forEach(bindProductDetailButton);

    const updateDetailPrice = () => {
        if (!current) return;
        let originalPrice = current.basePrice;
        if (selectedSize === "Nhỏ") originalPrice -= 5000;
        else if (selectedSize === "Lớn") originalPrice += 10000;
        originalPrice = Math.max(originalPrice, 0);

        const finalPrice = current.discountPercent > 0
            ? Math.max(Math.round(originalPrice * (100 - current.discountPercent) / 100), 0)
            : originalPrice;
        
        current.price = finalPrice;
        document.getElementById('detailPrice').innerHTML = current.discountPercent > 0
            ? `<div class="flex flex-col leading-tight"><span class="text-sm text-secondary line-through">${formatCurrency(originalPrice)}</span><span>${formatCurrency(finalPrice)}</span></div>`
            : formatCurrency(finalPrice);
    };

    // Click chọn Đường
    document.querySelectorAll('.sugar-option-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            selectedSugar = btn.dataset.sugar;
            document.querySelectorAll('.sugar-option-btn').forEach(b => {
                if (b === btn) {
                    b.className = "sugar-option-btn rounded-full border border-primary bg-primary px-4 py-1 font-caption text-on-primary";
                } else {
                    b.className = "sugar-option-btn rounded-full border border-outline px-4 py-1 font-caption text-secondary";
                }
            });
        });
    });

    // Click chọn Size
    document.querySelectorAll('.size-option-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            selectedSize = btn.dataset.size;
            document.querySelectorAll('.size-option-btn').forEach(b => {
                if (b === btn) {
                    b.className = "size-option-btn rounded-full border border-primary bg-primary px-4 py-1 font-caption text-on-primary";
                } else {
                    b.className = "size-option-btn rounded-full border border-outline px-4 py-1 font-caption text-secondary";
                }
            });
            updateDetailPrice();
        });
    });

    document.getElementById('detailAddBtn').addEventListener('click', () => {
        if (current) {
            addToCart({
                name: current.name,
                productId: current.productId,
                price: current.price,
                image: current.image,
                stock: current.stock,
                sugar: selectedSugar,
                size: selectedSize
            });
        }
        closeDetail();
    });

    // Lọc danh mục Client-side
    const categoryBtns = document.querySelectorAll('.category-btn');
    const productCards = () => document.querySelectorAll('.product-card');
    let activeCategoryId = "all";

    const setActiveCategoryButton = activeButton => {
        categoryBtns.forEach(button => {
            const isActive = button === activeButton;
            button.className = isActive
                ? "category-btn whitespace-nowrap rounded-full bg-primary px-6 py-2 font-label-md text-on-primary transition-soft"
                : "category-btn whitespace-nowrap rounded-full border border-outline bg-surface px-6 py-2 font-label-md text-primary transition-soft hover:bg-secondary-container";
        });
    };

    categoryBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            const categoryId = btn.dataset.categoryId;
            activeCategoryId = categoryId || "all";
            setActiveCategoryButton(btn);

            window.requestAnimationFrame(() => {
                productCards().forEach(card => {
                    const shouldShow = activeCategoryId === "all" || card.dataset.categoryId === categoryId;
                    card.classList.toggle('hidden', !shouldShow);
                });
            });
        });
    });

    const productImageFallback = '/images/default-coffee.svg';
    const productCardHtml = product => {
        const price = toNumber(product.price);
        const image = product.imageUrl || productImageFallback;
        const name = escapeHtml(product.name || 'Sản phẩm mới');
        const description = escapeHtml(product.description || '');
        const safeImage = escapeHtml(image);
        return `
            <article class="product-card render-list-item group overflow-hidden rounded-xl bg-surface-container-lowest shadow-[0_10px_30px_rgba(62,39,35,0.05)] transition-soft hover:-translate-y-1 hover:shadow-xl" data-product-id="${product.id}" data-category-id="${product.categoryId || ''}">
                <button type="button" class="js-open-detail block w-full text-left" data-product-id="${product.id}" data-name="${name}" data-description="${description}" data-price="${price}" data-stock="${Number.isFinite(Number(product.stock)) ? Number(product.stock) : ''}" data-discount-percent="0" data-display-price="${formatCurrency(price)}" data-image="${safeImage}">
                    <div class="relative aspect-square cursor-pointer overflow-hidden">
                        <img data-product-image class="h-full w-full object-cover transition-soft group-hover:scale-105" src="${safeImage}" alt="${name}" loading="lazy" decoding="async" fetchpriority="low" />
                        <div class="absolute right-4 top-4 rounded-full bg-white/80 p-2 backdrop-blur-md">
                            <span class="material-symbols-outlined text-primary">coffee</span>
                        </div>
                    </div>
                    <div class="p-gutter">
                        <h3 data-product-name class="mb-1 font-headline-md text-headline-md text-primary">${name}</h3>
                        <p data-product-description class="mb-4 line-clamp-2 font-body-md text-secondary">${description}</p>
                        <div class="flex items-center justify-between gap-3">
                            <span data-product-price class="font-label-md text-on-tertiary-container">
                                <span class="text-lg">${formatCurrency(price)}</span>
                            </span>
                            <span class="rounded-lg bg-primary px-4 py-2 font-label-md text-on-primary transition-soft hover:brightness-125">Thêm vào giỏ</span>
                        </div>
                    </div>
                </button>
            </article>`;
    };

    const updateProductCard = product => {
        if (!product?.id) return;

        productPricesById[product.id] = toNumber(product.price);
        if (Number.isFinite(Number(product.stock))) productStocksById[product.id] = Number(product.stock);
        if (product.name) productPrices[product.name] = toNumber(product.price);

        const menu = document.getElementById('menu');
        let card = document.querySelector(`.product-card[data-product-id="${product.id}"]`);
        if (!card && product.isAvailable !== false && menu) {
            menu.insertAdjacentHTML('afterbegin', productCardHtml(product));
            card = document.querySelector(`.product-card[data-product-id="${product.id}"]`);
            bindProductDetailButton(card?.querySelector('.js-open-detail'));
        }
        if (!card) return;

        const image = product.imageUrl || productImageFallback;
        const price = toNumber(product.price);
        card.dataset.categoryId = product.categoryId || '';
        card.classList.toggle('hidden', product.isAvailable === false || (activeCategoryId !== 'all' && String(card.dataset.categoryId) !== String(activeCategoryId)));

        const button = card.querySelector('.js-open-detail');
        if (button) {
            button.dataset.name = product.name || '';
            button.dataset.description = product.description || '';
            button.dataset.price = String(price);
            button.dataset.stock = Number.isFinite(Number(product.stock)) ? String(Number(product.stock)) : '';
            button.dataset.displayPrice = formatCurrency(price);
            button.dataset.image = image;
        }
        const imageElement = card.querySelector('[data-product-image]');
        if (imageElement) {
            imageElement.src = image;
            imageElement.alt = product.name || 'Sản phẩm';
        }
        const nameElement = card.querySelector('[data-product-name]');
        if (nameElement) nameElement.textContent = product.name || 'Sản phẩm';
        const descriptionElement = card.querySelector('[data-product-description]');
        if (descriptionElement) descriptionElement.textContent = product.description || '';
        const priceElement = card.querySelector('[data-product-price]');
        if (priceElement) priceElement.innerHTML = `<span class="text-lg">${formatCurrency(price)}</span>`;

        if (current?.productId === Number(product.id)) {
            current.name = product.name || current.name;
            current.basePrice = price;
            current.stock = Number.isFinite(Number(product.stock)) ? Number(product.stock) : current.stock;
            current.image = image;
            document.getElementById('detailTitle').textContent = current.name;
            document.getElementById('detailDesc').textContent = product.description || '';
            document.getElementById('detailImg').src = image;
            updateDetailPrice();
        }
        const cart = getCart()
            .map(item => {
                if (Number(item.productId) !== Number(product.id)) return item;

                const stock = Number.isFinite(Number(product.stock)) ? Number(product.stock) : item.stock;
                return {
                    ...item,
                    name: product.name || item.name,
                    image,
                    stock,
                    qty: stock !== null && stock <= 0 ? 0 : stock !== null ? Math.min(item.qty, stock) : item.qty
                };
            })
            .filter(item => item.qty > 0);
        setCart(cart);
        renderCart();
        syncCheckoutConfirm();
    };

    window.addEventListener('latte:ProductCreated', event => updateProductCard(event.detail));
    window.addEventListener('latte:ProductUpdated', event => updateProductCard(event.detail));
    window.addEventListener('latte:ProductDeleted', event => {
        const product = event.detail;
        if (!product?.id) return;
        document.querySelector(`.product-card[data-product-id="${product.id}"]`)?.remove();
        const cart = getCart().filter(item => Number(item.productId) !== Number(product.id));
        setCart(cart);
        renderCart();
        syncCheckoutConfirm();
        if (current?.productId === Number(product.id)) {
            window.closeDetail();
            current = null;
        }
    });

    document.getElementById('checkoutBtn').addEventListener('click', () => {
        const cart = getCart();
        if (!cart.length) {
            showCheckoutNotice({
                title: "Giỏ hàng đang trống",
                message: "Bạn hãy thêm sản phẩm Coffe vào giỏ hàng trước khi mua nhé.",
                type: "error"
            });
            return;
        }

        if (!isAuthenticated) {
            window.location.href = '/Account/Login?returnUrl=' + encodeURIComponent('/Product/Index');
            return;
        }

        openCheckoutConfirm();
    });

    // Xử lý sự kiện Checkout (đặt hàng) giảm Stock ở database
    checkoutConfirmBtn.addEventListener('click', async () => {
        const cart = getCart();
        if (!cart.length) {
            closeCheckoutConfirm();
            return;
        }

        try {
            if (!isAuthenticated) {
                window.location.href = '/Account/Login?returnUrl=' + encodeURIComponent('/Product/Index');
                return;
            }

            const response = await fetch('/Cart/Checkout', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    items: cart.map(item => ({
                        productId: item.productId,
                        name: item.name,
                        qty: item.qty,
                        sugar: item.sugar,
                        size: item.size
                    })),
                    fulfillmentMethod: selectedFulfillmentMethod()
                })
            });

            if (response.status === 401) {
                window.location.href = '/Account/Login?returnUrl=' + encodeURIComponent('/Product/Index');
                return;
            }

            const result = await response.json();
            if (response.ok && result.success) {
                const purchasedNames = cart
                    .map(item => item.name)
                    .filter((name, index, names) => names.indexOf(name) === index)
                    .slice(0, 3)
                    .join(", ");
                clearCart();
                closeCart();
                closeCheckoutConfirm();
                showCheckoutNotice({
                    title: "Đã đặt đơn hàng Coffe",
                    message: `Cảm ơn bạn đã đặt ${purchasedNames || "sản phẩm"} tại Coffe Latte Kawaii. Đơn hàng đã được chuyển đến Admin theo dõi.`,
                    type: "success"
                });
                window.showOrderToast?.(
                    result.orderId,
                    "Đặt hàng thành công",
                    "đã được gửi đến cửa hàng. Cảm ơn bạn!"
                );
            } else {
                showCheckoutNotice({
                    title: "Đặt hàng chưa thành công",
                    message: result.message || "Vui lòng thử lại sau ít phút.",
                    type: "error"
                });
            }
        } catch (error) {
            console.error("Lỗi đặt hàng:", error);
            showCheckoutNotice({
                title: "Không kết nối được máy chủ",
                message: "Có lỗi xảy ra khi đặt hàng. Vui lòng thử lại nhé.",
                type: "error"
            });
        }
    });

    renderCart();
    @if (TempData["RegisterNotice"] is string registerNotice)
    {
        <text>
        showCheckoutNotice({
            title: "Đăng ký thành công",
            message: @Json.Serialize(registerNotice),
            type: "success"
        });
        </text>
    }
})();
</script>
}


