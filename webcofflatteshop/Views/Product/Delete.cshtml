@model webcofflatteshop.Models.Product
@{
    ViewData["Title"] = "Xóa sản phẩm";
}

<nav class="sticky top-0 z-50 bg-surface shadow-[0_10px_30px_rgba(62,39,35,0.05)]">
    <div class="mx-auto flex h-20 w-full max-w-container-max items-center justify-between px-margin-mobile py-unit md:px-margin-desktop">
        <a asp-controller="Product" asp-action="Index" class="flex items-center gap-3">
            <span class="brand-blossom" aria-hidden="true">✼</span>
            <h1 class="font-['Noto_Serif'] text-[32px] font-bold leading-none">
                <span style="color:#3e2723">Coffe</span><span style="color:#81c784">-latte</span><span style="color:#f48fb1">Kawaii</span>
            </h1>
        </a>
        <div class="hidden items-center gap-gutter md:flex">
            <a asp-controller="Product" asp-action="Index" class="font-body-md text-secondary transition-colors duration-200 hover:text-primary">Menu</a>
            <a asp-controller="Product" asp-action="Add" class="font-body-md border-b-2 border-primary pb-1 text-primary">Manager</a>
        </div>
        <div class="flex items-center gap-unit">
            <a asp-controller="Account" asp-action="PurchaseHistory" class="rounded-lg px-3 py-2 font-label-md text-primary transition-colors hover:bg-secondary-container">Lịch sử</a>
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="rounded-lg px-3 py-2 font-label-md text-primary transition-colors hover:bg-secondary-container">Đăng xuất</button>
            </form>
        </div>
    </div>
</nav>

<main class="min-h-screen bg-background px-margin-mobile py-section-gap font-body text-on-background md:px-margin-desktop">
    <section class="mx-auto max-w-2xl rounded-xl border border-outline-variant/30 bg-surface-container-lowest p-gutter custom-shadow">
        <a asp-action="Add" class="mb-6 inline-flex items-center gap-2 text-secondary hover:text-primary">
            <span class="material-symbols-outlined text-[18px]">arrow_back</span>
            Quay lại danh sách sản phẩm
        </a>
        <h1 class="mb-3 font-headline-md text-primary">Xóa sản phẩm</h1>
        <p class="text-body-md text-secondary">Bạn có chắc muốn xóa sản phẩm <strong class="text-primary">@Model.Name</strong>?</p>

        <div class="mt-gutter rounded-lg border border-outline-variant bg-surface-container-low p-4">
            <p class="font-label-md text-primary">@Model.Price.ToString("N0")₫</p>
            <p class="mt-1 text-caption text-secondary">@Model.Description</p>
        </div>

        <form asp-action="DeleteConfirmed" method="post" class="mt-gutter">
            <input type="hidden" asp-for="Id" />
            <div class="flex flex-wrap gap-3">
                <button type="submit" class="inline-flex items-center gap-2 rounded-lg bg-error px-5 py-3 font-label-md text-on-error hover:brightness-110">
                    <span class="material-symbols-outlined text-[18px]">delete</span>
                    Xác nhận xóa
                </button>
                <a asp-action="Add" class="inline-flex items-center rounded-lg border border-outline-variant px-5 py-3 font-label-md text-secondary hover:bg-surface-container">Hủy</a>
            </div>
        </form>
    </section>
</main>
