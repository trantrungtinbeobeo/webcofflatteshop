@model webcofflatteshop.Models.AdminStatisticsViewModel
@{
    ViewData["Title"] = "Thống kê";
    var today = DateTime.Now.ToString("dddd, dd MMMM yyyy", new System.Globalization.CultureInfo("vi-VN"));
    var customerPurchases = Model.CustomerPurchases.ToList();
    var topCustomers = customerPurchases.Take(6).ToList();
    var maxSpent = customerPurchases.Any() ? customerPurchases.Max(item => item.TotalSpent) : 0m;
    var workflowTotal = Math.Max(Model.PendingOrders + Model.PreparingOrders + Model.DeliveringOrders + Model.CompletedOrders + Model.OutOfStockProducts + Model.PromoOrdersToday, 1);
    var pendingPercent = (double)Model.PendingOrders / workflowTotal * 100;
    var processingPercent = (double)(Model.PreparingOrders + Model.DeliveringOrders) / workflowTotal * 100;
    var completedPercent = (double)Model.CompletedOrders / workflowTotal * 100;
    var outOfStockPercent = (double)Model.OutOfStockProducts / workflowTotal * 100;
    var promoPercent = (double)Model.PromoOrdersToday / workflowTotal * 100;
    var pendingEnd = pendingPercent;
    var processingEnd = pendingEnd + processingPercent;
    var completedEnd = processingEnd + completedPercent;
    var outOfStockEnd = completedEnd + outOfStockPercent;
    string Percent(double value) => value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
}

<nav class="sticky top-0 z-50 bg-surface shadow-[0_10px_30px_rgba(62,39,35,0.05)]">
    <div class="mx-auto flex h-20 w-full max-w-container-max items-center justify-between px-margin-mobile py-unit md:px-margin-desktop">
        <a asp-controller="Product" asp-action="Index" class="flex items-center gap-3">
            <partial name="_SakuraLogoMark" />
            <h1 class="font-['Noto_Serif'] text-[32px] font-bold leading-none">
                <span style="color:#3e2723">Coffe</span><span style="color:#81c784">-latte</span><span style="color:#f48fb1">Kawaii</span>
            </h1>
        </a>
        <div class="hidden items-center gap-gutter md:flex">
            <a asp-controller="Product" asp-action="Index" class="font-body-md text-secondary transition-colors duration-200 hover:text-primary">Menu</a>
            <a asp-controller="Product" asp-action="Add" class="font-body-md border-b-2 border-primary pb-1 text-primary">Manager</a>
        </div>
        <div class="flex items-center gap-unit">
            <partial name="_UserAvatarHeader" />
            <a asp-controller="Account" asp-action="PurchaseHistory" class="rounded-lg px-3 py-2 font-label-md text-primary transition-colors hover:bg-secondary-container">Lịch sử đơn hàng</a>
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="rounded-lg px-3 py-2 font-label-md text-primary transition-colors hover:bg-secondary-container">Đăng xuất</button>
            </form>
        </div>
    </div>
</nav>

<aside class="fixed left-0 top-20 z-40 hidden h-[calc(100vh-5rem)] w-[280px] flex-col border-r border-outline-variant bg-surface-container-lowest p-gutter custom-shadow md:flex">
    <div class="mb-section-gap">
        <a asp-controller="Product" asp-action="Index" class="mb-10 flex items-center gap-3 rounded-lg transition hover:opacity-80">
            <partial name="_SakuraLogoMark" />
            <div>
                <p class="font-['Noto_Serif'] text-[22px] font-bold leading-none">
                    <span style="color:#3e2723">Coffe</span><span style="color:#81c784">-latte</span><span style="color:#f48fb1">Kawaii</span>
                </p>
                <p class="text-caption text-secondary">Admin Dashboard</p>
            </div>
        </a>
        <nav class="space-y-3">
            <a asp-action="Add" class="flex items-center gap-3 rounded-lg px-4 py-3 font-label-md text-secondary transition hover:bg-surface-container">
                <span class="material-symbols-outlined text-[18px]">inventory_2</span>
                Thêm sản phẩm
            </a>
            <a asp-controller="Category" asp-action="Index" class="flex items-center gap-3 rounded-lg px-4 py-3 font-label-md text-secondary transition hover:bg-surface-container">
                <span class="material-symbols-outlined text-[18px]">storefront</span>
                Danh mục
            </a>
            <a asp-action="UploadImageList" class="flex items-center gap-3 rounded-lg px-4 py-3 font-label-md text-secondary transition hover:bg-surface-container">
                <span class="material-symbols-outlined text-[18px]">add_photo_alternate</span>
                Ảnh & banner
            </a>
            <a asp-action="Statistics" class="flex items-center gap-3 rounded-lg bg-primary px-4 py-3 font-label-md text-on-primary">
                <span class="material-symbols-outlined text-[18px]">bar_chart</span>
                Thống kê
            </a>
            <a asp-controller="Account" asp-action="Profile" class="flex items-center gap-3 rounded-lg px-4 py-3 font-label-md text-secondary transition hover:bg-surface-container">
                <partial name="_UserAvatarIcon" />
                Trang cá nhân
            </a>
            <a asp-controller="Account" asp-action="ApiKeys" class="flex items-center gap-3 rounded-lg px-4 py-3 font-label-md text-secondary transition hover:bg-surface-container">
                <span class="material-symbols-outlined text-[18px]">key</span>
                Tạo API Key
            </a>
        </nav>
    </div>
    <div class="mt-auto border-t border-outline-variant pt-5">
        <partial name="_SidebarUserProfile" />
        <form asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="flex w-full items-center justify-center gap-2 rounded-lg border border-error px-4 py-2 font-label-md text-error transition-colors hover:bg-error-container">
                <span class="material-symbols-outlined text-[18px]">logout</span>
                Đăng xuất
            </button>
        </form>
    </div>
</aside>

<main class="min-h-screen bg-background p-margin-mobile md:ml-[280px] md:p-margin-desktop">
    <header class="mx-auto mb-gutter flex max-w-container-max items-end justify-between">
        <div>
            <nav class="mb-2 flex items-center gap-2 text-caption text-secondary">
                <span>Admin</span>
                <span class="material-symbols-outlined text-[12px]">chevron_right</span>
                <span class="font-semibold text-primary">Thống kê</span>
            </nav>
            <h1 class="font-headline-md text-primary">Tổng quan sản phẩm và banner</h1>
        </div>
        <div class="hidden md:block">
            <span class="text-caption font-medium uppercase tracking-widest text-secondary">@today</span>
        </div>
    </header>

    <section class="mx-auto max-w-container-max space-y-gutter">
        <div class="grid grid-cols-1 gap-gutter md:grid-cols-2 xl:grid-cols-4">
            <div class="rounded-xl border border-outline-variant/20 bg-surface-container-lowest p-gutter custom-shadow">
                <p class="text-caption text-secondary">Tổng sản phẩm</p>
                <p class="mt-3 font-headline-md text-headline-md text-primary">@Model.TotalProducts</p>
            </div>
            <div class="rounded-xl border border-outline-variant/20 bg-surface-container-lowest p-gutter custom-shadow">
                <p class="text-caption text-secondary">Đang bán</p>
                <p class="mt-3 font-headline-md text-headline-md text-primary">@Model.AvailableProducts</p>
            </div>
            <div class="rounded-xl border border-outline-variant/20 bg-surface-container-lowest p-gutter custom-shadow">
                <p class="text-caption text-secondary">Hết hàng</p>
                <p class="mt-3 font-headline-md text-headline-md text-error">@Model.OutOfStockProducts</p>
            </div>
            <div class="rounded-xl border border-outline-variant/20 bg-surface-container-lowest p-gutter custom-shadow">
                <p class="text-caption text-secondary">Khuyến mãi</p>
                <p class="mt-3 font-headline-md text-headline-md text-primary">@(Model.PromoBannerIsEnabled ? $"{Model.PromoBannerDiscountPercent}%" : "Tắt")</p>
            </div>
        </div>

        <div class="grid grid-cols-1 gap-gutter lg:grid-cols-2">
            <div class="rounded-xl border border-outline-variant/20 bg-surface-container-lowest p-gutter custom-shadow">
                <div class="mb-5">
                    <h2 class="font-headline-md text-primary">Biểu đồ tiến độ đơn hàng</h2>
                    <p class="mt-1 text-caption text-secondary">Theo dõi đơn chờ, đang xử lý, hoàn thành, hết hàng và khuyến mãi trong ngày.</p>
                </div>
                <div class="flex flex-col items-center gap-gutter md:flex-row">
                    <div id="workflowPieChart" class="relative h-44 w-44 rounded-full transition-all duration-500" style="background: conic-gradient(#d9a441 0 @Percent(pendingEnd)%, #745853 @Percent(pendingEnd)% @Percent(processingEnd)%, #2e7d32 @Percent(processingEnd)% @Percent(completedEnd)%, #ba1a1a @Percent(completedEnd)% @Percent(outOfStockEnd)%, #7c6bd6 @Percent(outOfStockEnd)% 100%);">
                        <div class="absolute inset-6 flex flex-col items-center justify-center rounded-full bg-surface-container-lowest text-center">
                            <span id="workflowTotalCount" class="font-headline-md text-headline-md text-primary">@workflowTotal</span>
                            <span class="text-caption text-secondary">mục theo dõi</span>
                        </div>
                    </div>
                    <div class="w-full flex-1 space-y-3">
                        <div class="flex items-center justify-between gap-3">
                            <span class="flex items-center gap-2 text-body-md text-secondary"><i class="h-3 w-3 rounded-full bg-[#d9a441]"></i>Đơn đang chờ</span>
                            <span id="workflowPendingCount" class="font-label-md text-primary">@Model.PendingOrders</span>
                        </div>
                        <div class="flex items-center justify-between gap-3">
                            <span class="flex items-center gap-2 text-body-md text-secondary"><i class="h-3 w-3 rounded-full bg-[#745853]"></i>Đang pha/giao</span>
                            <span id="workflowProcessingCount" class="font-label-md text-primary">@(Model.PreparingOrders + Model.DeliveringOrders)</span>
                        </div>
                        <div class="flex items-center justify-between gap-3">
                            <span class="flex items-center gap-2 text-body-md text-secondary"><i class="h-3 w-3 rounded-full bg-[#2e7d32]"></i>Bán thành công</span>
                            <span id="workflowCompletedCount" class="font-label-md text-primary">@Model.CompletedOrders</span>
                        </div>
                        <div class="flex items-center justify-between gap-3">
                            <span class="flex items-center gap-2 text-body-md text-secondary"><i class="h-3 w-3 rounded-full bg-error"></i>Hết hàng</span>
                            <span class="font-label-md text-primary">@Model.OutOfStockProducts</span>
                        </div>
                        <div class="flex items-center justify-between gap-3">
                            <span class="flex items-center gap-2 text-body-md text-secondary"><i class="h-3 w-3 rounded-full bg-[#7c6bd6]"></i>Khuyến mãi hôm nay</span>
                            <span id="workflowPromoCount" class="font-label-md text-primary">@Model.PromoOrdersToday</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="rounded-xl border border-outline-variant/20 bg-surface-container-lowest p-gutter custom-shadow">
                <div class="mb-5">
                    <h2 class="font-headline-md text-primary">Biểu đồ cột tài khoản mua hàng</h2>
                    <p class="mt-1 text-caption text-secondary">Top tài khoản theo tổng giá trị đơn hàng.</p>
                </div>
                @if (!topCustomers.Any())
                {
                    <p class="rounded-lg bg-surface-container-low p-4 text-body-md text-secondary">Chưa có dữ liệu mua hàng để vẽ biểu đồ.</p>
                }
                else
                {
                    <div class="flex h-64 items-end gap-3 rounded-lg bg-surface-container-low p-4">
                        @foreach (var customer in topCustomers)
                        {
                            var barPercent = maxSpent > 0 ? Math.Max((double)(customer.TotalSpent / maxSpent) * 100, 8) : 8;
                            <div class="flex h-full flex-1 flex-col items-center justify-end gap-2">
                                <span class="text-[11px] font-semibold text-primary">@customer.TotalSpent.ToString("N0")đ</span>
                                <div class="w-full rounded-t-lg bg-[#2e7d32] transition" style="height:@Percent(barPercent)%"></div>
                                <span class="line-clamp-1 w-full text-center text-[11px] text-secondary" title="@(string.IsNullOrWhiteSpace(customer.FullName) ? customer.UserName : customer.FullName)">
                                    @(string.IsNullOrWhiteSpace(customer.FullName) ? customer.UserName : customer.FullName)
                                </span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="rounded-xl border border-outline-variant/20 bg-surface-container-lowest p-gutter custom-shadow">
            <div class="mb-5 flex flex-wrap items-end justify-between gap-3">
                <div>
                    <h2 class="font-headline-md text-primary">Biểu đồ tài khoản đã mua hàng</h2>
                    <p class="mt-1 text-caption text-secondary">Xếp theo tổng số tiền đã mua.</p>
                </div>
                <span class="rounded-full bg-secondary-container px-3 py-1 text-caption font-semibold text-on-secondary-container">@customerPurchases.Count khách hàng</span>
            </div>

            @if (!customerPurchases.Any())
            {
                <p class="rounded-lg bg-surface-container-low p-4 text-body-md text-secondary">Chưa có tài khoản nào mua hàng.</p>
            }
            else
            {
                <div class="space-y-4">
                    @foreach (var customer in customerPurchases.Take(8))
                    {
                        var percent = maxSpent > 0 ? Math.Max((double)(customer.TotalSpent / maxSpent) * 100, 8) : 8;
                        <div>
                            <div class="mb-2 flex flex-wrap items-center justify-between gap-3">
                                <div>
                                    <p class="font-label-md text-primary">@(string.IsNullOrWhiteSpace(customer.FullName) ? customer.UserName : customer.FullName)</p>
                                    <p class="text-caption text-secondary">@customer.Email - @customer.OrderCount đơn</p>
                                </div>
                                <p class="font-label-md text-primary">@customer.TotalSpent.ToString("N0")đ</p>
                            </div>
                            <div class="h-3 overflow-hidden rounded-full bg-surface-container">
                                <div class="h-full rounded-full bg-[#2e7d32]" style="width:@percent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="grid grid-cols-1 gap-gutter lg:grid-cols-12">
            <div class="lg:col-span-8">
                <div class="overflow-hidden rounded-xl border border-outline-variant/20 bg-white custom-shadow">
                    <table class="w-full border-collapse text-left">
                        <thead class="bg-surface-container-low">
                            <tr>
                                <th class="px-gutter py-4 font-label-md text-secondary">Sản phẩm</th>
                                <th class="px-gutter py-4 font-label-md text-secondary">Danh mục</th>
                                <th class="px-gutter py-4 font-label-md text-secondary">Tồn kho</th>
                                <th class="px-gutter py-4 text-right font-label-md text-secondary">Giá trị kho</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-outline-variant/10">
                            @foreach (var product in Model.RecentProducts)
                            {
                                <tr class="transition-colors hover:bg-surface-container-lowest">
                                    <td class="px-gutter py-4">
                                        <p class="font-label-md text-primary">@product.Name</p>
                                        <p class="text-caption text-secondary">ID: PRD-@product.Id.ToString("000")</p>
                                    </td>
                                    <td class="px-gutter py-4 text-body-md text-secondary">@product.Category?.Name</td>
                                    <td class="px-gutter py-4 text-body-md text-primary">@product.Stock</td>
                                    <td class="px-gutter py-4 text-right text-body-md font-medium text-primary">@((product.Price * product.Stock).ToString("N0"))đ</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <aside class="space-y-gutter lg:col-span-4">
                <div class="rounded-xl border border-outline-variant/20 bg-surface-container-lowest p-gutter custom-shadow">
                    <h2 class="mb-4 font-label-md text-primary">Chỉ số nhanh</h2>
                    <div class="space-y-4 text-body-md">
                        <div class="flex justify-between gap-4">
                            <span class="text-secondary">Danh mục đang có sản phẩm</span>
                            <span class="font-semibold text-primary">@Model.TotalCategories</span>
                        </div>
                        <div class="flex justify-between gap-4">
                            <span class="text-secondary">Món nổi bật</span>
                            <span class="font-semibold text-primary">@Model.FeaturedProducts</span>
                        </div>
                        <div class="flex justify-between gap-4">
                            <span class="text-secondary">Banner khuyến mãi</span>
                            <span class="font-semibold text-primary">@(Model.PromoBannerIsEnabled ? "Đang áp dụng" : "Chưa áp dụng")</span>
                        </div>
                        <div class="flex justify-between gap-4">
                            <span class="text-secondary">Mức khuyến mãi</span>
                            <span class="font-semibold text-primary">@Model.PromoBannerDiscountPercent%</span>
                        </div>
                    </div>
                </div>
                <div class="rounded-xl border border-outline-variant/20 bg-surface-container-low p-gutter">
                    <p class="text-caption text-secondary">Tổng giá trị tồn kho</p>
                    <p class="mt-3 font-headline-md text-headline-md text-primary">@Model.TotalInventoryValue.ToString("N0")đ</p>
                </div>
            </aside>
        </div>
    </section>
</main>

<script>
(() => {
    const pieChart = document.getElementById('workflowPieChart');
    if (!pieChart) return;

    const setText = (id, value) => {
        const element = document.getElementById(id);
        if (element) element.textContent = value;
    };

    const updatePie = data => {
        const pending = Number(data.pendingOrders || 0);
        const processing = Number(data.preparingOrders || 0) + Number(data.deliveringOrders || 0);
        const completed = Number(data.completedOrders || 0);
        const promo = Number(data.promoOrdersToday || 0);
        const outOfStock = @Json.Serialize(Model.OutOfStockProducts);
        const total = Math.max(pending + processing + completed + outOfStock + promo, 1);
        const pendingEnd = pending / total * 100;
        const processingEnd = pendingEnd + processing / total * 100;
        const completedEnd = processingEnd + completed / total * 100;
        const outOfStockEnd = completedEnd + outOfStock / total * 100;

        pieChart.style.background = `conic-gradient(#d9a441 0 ${pendingEnd}%, #745853 ${pendingEnd}% ${processingEnd}%, #2e7d32 ${processingEnd}% ${completedEnd}%, #ba1a1a ${completedEnd}% ${outOfStockEnd}%, #7c6bd6 ${outOfStockEnd}% 100%)`;
        setText('workflowTotalCount', total);
        setText('workflowPendingCount', pending);
        setText('workflowProcessingCount', processing);
        setText('workflowCompletedCount', completed);
        setText('workflowPromoCount', promo);
    };

    let statisticsPollInFlight = false;
    const pollStatistics = async () => {
        if (document.hidden || statisticsPollInFlight) return;
        statisticsPollInFlight = true;
        try {
            const response = await fetch('/Product/StatisticsSummary', { cache: 'no-store' });
            if (!response.ok) return;
            updatePie(await response.json());
        } catch {
            // Polling silently retries on the next tick.
        } finally {
            statisticsPollInFlight = false;
        }
    };

    window.setInterval(pollStatistics, 5000);
    pollStatistics();
})();
</script>


