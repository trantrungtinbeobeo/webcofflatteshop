<!DOCTYPE html>
<html lang="vi" class="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Coffe-latteKawaii</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif:wght@400;600;700&family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "on-surface": "#1a1c19",
                        "surface-container-highest": "#e3e3de",
                        "on-error-container": "#93000a",
                        "on-secondary-container": "#676351",
                        "primary-fixed": "#ffdad4",
                        "on-error": "#ffffff",
                        "surface-dim": "#dadad5",
                        "outline": "#827472",
                        "tertiary": "#241500",
                        "secondary-fixed": "#e9e2cc",
                        "on-surface-variant": "#504442",
                        "surface-container-low": "#f4f4ef",
                        "error-container": "#ffdad6",
                        "surface": "#fafaf5",
                        "background": "#fafaf5",
                        "tertiary-container": "#3c290c",
                        "secondary-container": "#e6e0c9",
                        "surface-tint": "#745853",
                        "primary-container": "#3e2723",
                        "surface-container-lowest": "#ffffff",
                        "on-background": "#1a1c19",
                        "outline-variant": "#d3c3c0",
                        "error": "#ba1a1a",
                        "primary": "#271310",
                        "on-primary": "#ffffff",
                        "inverse-primary": "#e3beb8",
                        "surface-container": "#eeeee9",
                        "surface-bright": "#fafaf5",
                        "on-primary-container": "#ae8d87",
                        "on-secondary": "#ffffff",
                        "secondary": "#625f4d",
                        "surface-container-high": "#e8e8e3",
                        "surface-variant": "#e3e3de"
                    },
                    borderRadius: {
                        DEFAULT: "0.25rem",
                        lg: "0.5rem",
                        xl: "0.75rem",
                        full: "9999px"
                    },
                    spacing: {
                        "margin-mobile": "16px",
                        "unit": "8px",
                        "gutter": "24px",
                        "section-gap": "80px",
                        "container-max": "1200px",
                        "margin-desktop": "40px"
                    },
                    fontFamily: {
                        "display": ["Noto Serif", "serif"],
                        "display-lg": ["Noto Serif", "serif"],
                        "headline-lg": ["Noto Serif", "serif"],
                        "headline-md": ["Noto Serif", "serif"],
                        "body": ["Be Vietnam Pro", "sans-serif"],
                        "body-md": ["Be Vietnam Pro", "sans-serif"],
                        "body-lg": ["Be Vietnam Pro", "sans-serif"],
                        "caption": ["Be Vietnam Pro", "sans-serif"],
                        "label-md": ["Be Vietnam Pro", "sans-serif"]
                    },
                    fontSize: {
                        "display-lg": ["48px", { lineHeight: "56px", letterSpacing: "-0.02em", fontWeight: "700" }],
                        "body-md": ["16px", { lineHeight: "24px", fontWeight: "400" }],
                        "body-lg": ["18px", { lineHeight: "28px", fontWeight: "400" }],
                        "caption": ["12px", { lineHeight: "16px", fontWeight: "400" }],
                        "headline-lg": ["32px", { lineHeight: "40px", fontWeight: "600" }],
                        "label-md": ["14px", { lineHeight: "20px", letterSpacing: "0.05em", fontWeight: "600" }],
                        "headline-md": ["24px", { lineHeight: "32px", fontWeight: "600" }]
                    }
                }
            }
        }
    </script>
</head>
<body class="coffee-pattern-bg bg-background font-body text-on-background selection:bg-primary-fixed">
    @RenderBody()

    @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
    {
        <aside id="newOrderToast" class="order-toast" aria-live="polite" aria-hidden="true">
            <a id="newOrderToastLink" class="order-toast-link" asp-controller="Account" asp-action="PurchaseHistory">
                <span class="order-toast-icon material-symbols-outlined">notifications_active</span>
                <span class="min-w-0 flex-1">
                    <strong class="block text-[13px] font-semibold text-white">Đơn hàng mới</strong>
                    <span class="mt-1 block text-[12px] leading-5 text-white/80">
                        Đơn hàng <span id="newOrderToastCode" class="font-semibold text-white underline underline-offset-2">#DH00000</span> vừa được đặt.
                    </span>
                </span>
            </a>
            <button id="newOrderToastClose" class="order-toast-close material-symbols-outlined" type="button" aria-label="Đóng thông báo">close</button>
        </aside>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
    {
        <script>
            (() => {
                const toast = document.getElementById('newOrderToast');
                const toastLink = document.getElementById('newOrderToastLink');
                const toastCode = document.getElementById('newOrderToastCode');
                const toastClose = document.getElementById('newOrderToastClose');
                const latestOrderStorageKey = 'coffeeLatteLatestAdminOrderId';
                let hideTimer;
                let globalOrderPollInFlight = false;

                window.showNewOrderToast = orderId => {
                    const numericOrderId = Number(orderId);
                    if (!toast || !toastLink || !toastCode || !numericOrderId) return;

                    toastCode.textContent = `#DH${String(numericOrderId).padStart(5, '0')}`;
                    toastLink.href = `/Account/PurchaseHistory?focusOrderId=${numericOrderId}#order-${numericOrderId}`;
                    toast.classList.add('is-visible');
                    toast.setAttribute('aria-hidden', 'false');
                    window.clearTimeout(hideTimer);
                    hideTimer = window.setTimeout(() => window.hideNewOrderToast(), 7000);
                };

                window.hideNewOrderToast = () => {
                    toast?.classList.remove('is-visible');
                    toast?.setAttribute('aria-hidden', 'true');
                };

                toastClose?.addEventListener('click', window.hideNewOrderToast);

                const pollNewOrders = async () => {
                    if (document.hidden || globalOrderPollInFlight) return;
                    globalOrderPollInFlight = true;
                    try {
                        const response = await fetch('/Account/AdminOrderSummary', { cache: 'no-store' });
                        if (!response.ok) return;
                        const data = await response.json();
                        const latestOrderId = Number(data.latestOrderId || 0);
                        const storedOrderId = sessionStorage.getItem(latestOrderStorageKey);
                        const previousOrderId = Number(storedOrderId || 0);

                        if (latestOrderId && storedOrderId !== null && latestOrderId > previousOrderId) {
                            window.showNewOrderToast(latestOrderId);
                        }
                        sessionStorage.setItem(latestOrderStorageKey, String(latestOrderId));
                    } catch {
                        // Polling silently retries on the next tick.
                    } finally {
                        globalOrderPollInFlight = false;
                    }
                };

                if (!window.location.pathname.toLowerCase().includes('/account/purchasehistory')) {
                    pollNewOrders();
                    window.setInterval(pollNewOrders, 5000);
                }
            })();
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
