<!DOCTYPE html>
<html lang="vi" class="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Coffe-latteKawaii</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif:wght@400;600;700&family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "on-surface": "#1a1c19",
                        "surface-container-highest": "#e3e3de",
                        "on-error-container": "#93000a",
                        "on-secondary-container": "#676351",
                        "primary-fixed": "#ffdad4",
                        "on-error": "#ffffff",
                        "surface-dim": "#dadad5",
                        "outline": "#827472",
                        "tertiary": "#241500",
                        "secondary-fixed": "#e9e2cc",
                        "on-surface-variant": "#504442",
                        "surface-container-low": "#f4f4ef",
                        "error-container": "#ffdad6",
                        "surface": "#fafaf5",
                        "background": "#fafaf5",
                        "tertiary-container": "#3c290c",
                        "secondary-container": "#e6e0c9",
                        "surface-tint": "#745853",
                        "primary-container": "#3e2723",
                        "surface-container-lowest": "#ffffff",
                        "on-background": "#1a1c19",
                        "outline-variant": "#d3c3c0",
                        "error": "#ba1a1a",
                        "primary": "#271310",
                        "on-primary": "#ffffff",
                        "inverse-primary": "#e3beb8",
                        "surface-container": "#eeeee9",
                        "surface-bright": "#fafaf5",
                        "on-primary-container": "#ae8d87",
                        "on-secondary": "#ffffff",
                        "secondary": "#625f4d",
                        "surface-container-high": "#e8e8e3",
                        "surface-variant": "#e3e3de"
                    },
                    borderRadius: {
                        DEFAULT: "0.25rem",
                        lg: "0.5rem",
                        xl: "0.75rem",
                        full: "9999px"
                    },
                    spacing: {
                        "margin-mobile": "16px",
                        "unit": "8px",
                        "gutter": "24px",
                        "section-gap": "80px",
                        "container-max": "1200px",
                        "margin-desktop": "40px"
                    },
                    fontFamily: {
                        "display": ["Noto Serif", "serif"],
                        "display-lg": ["Noto Serif", "serif"],
                        "headline-lg": ["Noto Serif", "serif"],
                        "headline-md": ["Noto Serif", "serif"],
                        "body": ["Be Vietnam Pro", "sans-serif"],
                        "body-md": ["Be Vietnam Pro", "sans-serif"],
                        "body-lg": ["Be Vietnam Pro", "sans-serif"],
                        "caption": ["Be Vietnam Pro", "sans-serif"],
                        "label-md": ["Be Vietnam Pro", "sans-serif"]
                    },
                    fontSize: {
                        "display-lg": ["48px", { lineHeight: "56px", letterSpacing: "-0.02em", fontWeight: "700" }],
                        "body-md": ["16px", { lineHeight: "24px", fontWeight: "400" }],
                        "body-lg": ["18px", { lineHeight: "28px", fontWeight: "400" }],
                        "caption": ["12px", { lineHeight: "16px", fontWeight: "400" }],
                        "headline-lg": ["32px", { lineHeight: "40px", fontWeight: "600" }],
                        "label-md": ["14px", { lineHeight: "20px", letterSpacing: "0.05em", fontWeight: "600" }],
                        "headline-md": ["24px", { lineHeight: "32px", fontWeight: "600" }]
                    }
                }
            }
        }
    </script>
</head>
<body class="coffee-pattern-bg bg-background font-body text-on-background selection:bg-primary-fixed">
    @RenderBody()

    <aside id="newOrderToast" class="order-toast" aria-live="polite" aria-hidden="true">
            <div class="order-toast-content">
                <span class="order-toast-icon material-symbols-outlined">notifications_active</span>
                <span class="min-w-0 flex-1">
                    <strong id="newOrderToastTitle" class="block text-[13px] font-semibold text-white">Đơn hàng mới</strong>
                    <span class="mt-1 block text-[12px] leading-5 text-white/80">
                        <span id="newOrderToastPrefix">Đơn hàng</span>
                        <a id="newOrderToastLink" class="order-toast-order-link" asp-controller="Account" asp-action="PurchaseHistory">
                            <span id="newOrderToastCode">#DH00000</span>
                        </a>
                        <span id="newOrderToastSuffix">vừa được đặt.</span>
                    </span>
                    <span id="newOrderToastActions" class="order-toast-actions hidden">
                        <button id="newOrderToastConfirm" type="button" class="order-toast-action-primary">Xóa</button>
                        <button id="newOrderToastCancel" type="button" class="order-toast-action-secondary">Không xóa</button>
                    </span>
                </span>
            </div>
            <button id="newOrderToastClose" class="order-toast-close material-symbols-outlined" type="button" aria-label="Đóng thông báo">close</button>
        </aside>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script>
        (() => {
                const toast = document.getElementById('newOrderToast');
                const toastLink = document.getElementById('newOrderToastLink');
                const toastTitle = document.getElementById('newOrderToastTitle');
                const toastPrefix = document.getElementById('newOrderToastPrefix');
                const toastCode = document.getElementById('newOrderToastCode');
                const toastSuffix = document.getElementById('newOrderToastSuffix');
                const toastClose = document.getElementById('newOrderToastClose');
                const toastActions = document.getElementById('newOrderToastActions');
                const toastConfirm = document.getElementById('newOrderToastConfirm');
                const toastCancel = document.getElementById('newOrderToastCancel');
                const isAuthenticated = @Json.Serialize(User.Identity?.IsAuthenticated == true);
                const isAdmin = @Json.Serialize(User.IsInRole("Admin"));
                const latestOrderStorageKey = 'coffeeLatteLatestAdminOrderId';
                const customerStatusStorageKey = 'coffeeLatteCustomerOrderStatuses';
                const statusNotices = {
                    Pending: { title: 'Đơn hàng đang chờ xử lý', suffix: 'đang chờ cửa hàng xác nhận.' },
                    Preparing: { title: 'Đơn hàng đang được xử lý', suffix: 'đang được pha chế.' },
                    Delivering: { title: 'Đơn hàng đang giao', suffix: 'đang trên đường giao đến bạn.' },
                    Completed: { title: 'Đơn hàng đã hoàn thành', suffix: 'đã được hoàn thành. Cảm ơn bạn!' }
                };
                let hideTimer;
                let globalOrderPollInFlight = false;
                let pendingToastResolve;

                window.showOrderToast = (orderId, title = 'Đơn hàng mới', suffix = 'vừa được đặt.', options = {}) => {
                    const numericOrderId = Number(orderId);
                    if (!toast || !toastLink || !toastTitle || !toastPrefix || !toastCode || !toastSuffix) return;

                    toastTitle.textContent = title;
                    toastPrefix.textContent = options.prefix ?? (numericOrderId ? 'Đơn hàng' : '');
                    toastCode.textContent = numericOrderId ? `#DH${String(numericOrderId).padStart(5, '0')}` : '';
                    toastSuffix.textContent = suffix;
                    toastLink.href = numericOrderId ? `/Account/PurchaseHistory?focusOrderId=${numericOrderId}#order-${numericOrderId}` : '#';
                    toastLink.classList.toggle('hidden', !numericOrderId);
                    toastActions?.classList.toggle('hidden', !options.actions);
                    toast.classList.add('is-visible');
                    toast.setAttribute('aria-hidden', 'false');
                    window.clearTimeout(hideTimer);
                    if (!options.actions) {
                        hideTimer = window.setTimeout(() => window.hideNewOrderToast(), 7000);
                    }
                };
                window.showNewOrderToast = orderId => window.showOrderToast(orderId);
                window.showOrderStatusToast = (orderId, status) => {
                    const notice = statusNotices[status] || statusNotices.Pending;
                    window.showOrderToast(orderId, notice.title, notice.suffix);
                };

                window.hideNewOrderToast = () => {
                    toast?.classList.remove('is-visible');
                    toast?.setAttribute('aria-hidden', 'true');
                    toastActions?.classList.add('hidden');
                };

                toastClose?.addEventListener('click', () => {
                    pendingToastResolve?.(false);
                    pendingToastResolve = null;
                    window.hideNewOrderToast();
                });
                toastLink?.addEventListener('click', event => {
                    if (!toastCode?.textContent) event.preventDefault();
                });
                toastConfirm?.addEventListener('click', () => {
                    pendingToastResolve?.(true);
                    pendingToastResolve = null;
                    window.hideNewOrderToast();
                });
                toastCancel?.addEventListener('click', () => {
                    pendingToastResolve?.(false);
                    pendingToastResolve = null;
                    window.hideNewOrderToast();
                });
                window.confirmOrderToast = orderId => new Promise(resolve => {
                    pendingToastResolve = resolve;
                    window.showOrderToast(orderId, 'Xóa lịch sử đơn hàng?', 'sẽ bị xóa khỏi lịch sử.', { actions: true });
                });
                window.showAppToast = (title, message) => {
                    window.showOrderToast(0, title, message, { prefix: '' });
                };

                const productRealtimeMessages = {
                    ProductCreated: product => ({
                        title: 'Sản phẩm mới',
                        message: `${product?.name || 'Một sản phẩm'} vừa được thêm từ API.`
                    }),
                    ProductUpdated: product => ({
                        title: 'Sản phẩm vừa cập nhật',
                        message: `${product?.name || 'Một sản phẩm'} đã đổi thông tin, giá hoặc tồn kho.`
                    }),
                    ProductDeleted: product => ({
                        title: 'Sản phẩm đã xóa',
                        message: `${product?.name || 'Một sản phẩm'} vừa được xóa từ API.`
                    })
                };

                const dispatchProductRealtime = (eventName, product) => {
                    const notice = productRealtimeMessages[eventName]?.(product);
                    if (notice) {
                        window.showAppToast?.(notice.title, notice.message);
                    }
                    window.dispatchEvent(new CustomEvent(`latte:${eventName}`, { detail: product }));
                };

                const connectProductRealtime = async () => {
                    if (!window.signalR) {
                        console.warn('SignalR client script was not loaded. Product realtime is disabled.');
                        return;
                    }

                    const connection = new signalR.HubConnectionBuilder()
                        .withUrl('/hubs/products')
                        .withAutomaticReconnect()
                        .build();

                    ['ProductCreated', 'ProductUpdated', 'ProductDeleted'].forEach(eventName => {
                        connection.on(eventName, product => dispatchProductRealtime(eventName, product));
                    });

                    try {
                        await connection.start();
                    } catch {
                        window.setTimeout(connectProductRealtime, 5000);
                    }
                };

                connectProductRealtime();

                if (!isAuthenticated) return;

                const pollOrders = async () => {
                    if (document.hidden || globalOrderPollInFlight) return;
                    globalOrderPollInFlight = true;
                    try {
                        const response = await fetch(isAdmin ? '/Account/AdminOrderSummary' : '/Account/OrderRealtimeSummary', { cache: 'no-store' });
                        if (!response.ok) return;
                        const data = await response.json();
                        if (isAdmin) {
                            const latestOrderId = Number(data.latestOrderId || 0);
                            const storedOrderId = sessionStorage.getItem(latestOrderStorageKey);
                            const previousOrderId = Number(storedOrderId || 0);

                            if (latestOrderId && storedOrderId !== null && latestOrderId > previousOrderId) {
                                window.showNewOrderToast(latestOrderId);
                            }
                            sessionStorage.setItem(latestOrderStorageKey, String(latestOrderId));
                            return;
                        }

                        const storedStatuses = JSON.parse(sessionStorage.getItem(customerStatusStorageKey) || '{}');
                        const orders = data.orders || [];
                        const changedOrder = orders.find(order =>
                            Object.prototype.hasOwnProperty.call(storedStatuses, order.id) &&
                            storedStatuses[order.id] !== order.status);
                        if (changedOrder) {
                            window.showOrderStatusToast(changedOrder.id, changedOrder.status);
                        }
                        orders.forEach(order => storedStatuses[order.id] = order.status);
                        sessionStorage.setItem(customerStatusStorageKey, JSON.stringify(storedStatuses));
                    } catch {
                        // Polling silently retries on the next tick.
                    } finally {
                        globalOrderPollInFlight = false;
                    }
                };

                if (!window.location.pathname.toLowerCase().includes('/account/purchasehistory')) {
                    pollOrders();
                    window.setInterval(pollOrders, 5000);
                }
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
