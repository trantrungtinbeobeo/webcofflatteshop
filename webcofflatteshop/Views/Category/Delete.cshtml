@model webcofflatteshop.Models.Category
@{
    ViewData["Title"] = "Xóa danh mục";
}

<div class="container py-4">
    <h1>Xóa danh mục</h1>

    <div class="card mt-3 p-4 shadow-sm">
        <p>Bạn có chắc muốn xóa danh mục <strong>@Model.Name</strong>?</p>
        @if (Model.Products.Any())
        {
            <div class="alert alert-warning">Danh mục này đang có @Model.Products.Count sản phẩm nên không thể xóa.</div>
        }
        <form asp-action="DeleteConfirmed" method="post" class="d-flex gap-2">
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-danger" disabled="@Model.Products.Any()">Xóa</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
        </form>
    </div>
</div>
