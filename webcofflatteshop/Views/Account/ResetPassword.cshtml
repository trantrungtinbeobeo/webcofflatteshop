@model webcofflatteshop.Models.ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<main class="flex min-h-screen items-center justify-center bg-background px-margin-mobile py-section-gap">
    <section class="w-full max-w-md rounded-xl border border-outline-variant/20 bg-surface-container-lowest p-gutter shadow-[0_10px_30px_rgba(62,39,35,0.06)]">
        <a asp-controller="Product" asp-action="Index" class="mb-8 flex items-center justify-center gap-3">
            <partial name="_SakuraLogoMark" />
            <span class="font-headline-md text-headline-md">
                <span style="color:#3e2723">Coffe</span>
                <span style="color:#81c784">Latte</span>
                <span style="color:#f48fb1">Kawaii</span>
            </span>
        </a>

        <h1 class="mb-2 font-headline-md text-headline-md text-primary">Đặt lại mật khẩu</h1>
        <p class="mb-6 text-body-md text-secondary">Tạo mật khẩu mới cho tài khoản của bạn.</p>

        <form asp-action="ResetPassword" method="post" class="space-y-5">
            <input asp-for="UserId" type="hidden" />
            <input asp-for="Token" type="hidden" />
            <div asp-validation-summary="All" class="rounded-lg bg-error-container px-4 py-3 text-sm text-on-error-container"></div>
            <div>
                <label asp-for="Password" class="mb-2 block font-label-md text-secondary">Mật khẩu mới</label>
                <input asp-for="Password" class="w-full rounded-lg border border-outline-variant bg-white px-4 py-3 outline-none focus:border-primary focus:ring-1 focus:ring-primary" autocomplete="new-password" />
                <span asp-validation-for="Password" class="mt-1 block text-sm text-error"></span>
            </div>
            <div>
                <label asp-for="ConfirmPassword" class="mb-2 block font-label-md text-secondary">Xác nhận mật khẩu</label>
                <input asp-for="ConfirmPassword" class="w-full rounded-lg border border-outline-variant bg-white px-4 py-3 outline-none focus:border-primary focus:ring-1 focus:ring-primary" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="mt-1 block text-sm text-error"></span>
            </div>
            <button type="submit" class="w-full rounded-lg bg-primary px-4 py-3 font-label-md text-on-primary">Cập nhật mật khẩu</button>
        </form>
    </section>
</main>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
