@model webcofflatteshop.Models.ProfilePageViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Trang cá nhân";
    var today = DateTime.Now.ToString("dddd, dd MMMM yyyy", new CultureInfo("vi-VN"));
    var roles = Model.Roles.Any() ? string.Join(", ", Model.Roles) : "Customer";
    var initial = string.IsNullOrWhiteSpace(Model.Profile.FullName)
        ? (string.IsNullOrWhiteSpace(Model.Profile.UserName) ? "U" : Model.Profile.UserName[..1].ToUpperInvariant())
        : Model.Profile.FullName[..1].ToUpperInvariant();
    var avatarImage = string.IsNullOrWhiteSpace(Model.ProfileBackgroundImageUrl)
        ? "/images/default-coffee.svg"
        : Model.ProfileBackgroundImageUrl;
    var emailStatusText = Model.EmailConfirmed ? "Đã xác thực" : "Chưa xác thực";
    var emailStatusClass = Model.EmailConfirmed ? "bg-green-100 text-green-700" : "bg-orange-100 text-orange-700";
}

<nav class="sticky top-0 z-50 bg-surface shadow-[0_10px_30px_rgba(62,39,35,0.05)]">
    <div class="mx-auto flex h-20 w-full max-w-container-max items-center justify-between px-margin-mobile py-unit md:px-margin-desktop">
        <a asp-controller="Product" asp-action="Index" class="flex items-center gap-3">
            <partial name="_SakuraLogoMark" />
            <h1 class="font-['Noto_Serif'] text-[32px] font-bold leading-none">
                <span style="color:#3e2723">Coffe</span><span style="color:#81c784">-latte</span><span style="color:#f48fb1">Kawaii</span>
            </h1>
        </a>
        <div class="hidden items-center gap-gutter md:flex">
            <a asp-controller="Product" asp-action="Index" class="font-body-md text-secondary transition-colors duration-200 hover:text-primary">Menu</a>
            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="Product" asp-action="Add" class="font-body-md border-b-2 border-primary pb-1 text-primary">Manager</a>
            }
        </div>
        <div class="flex items-center gap-unit">
            <partial name="_UserAvatarHeader" />
            <a asp-controller="Account" asp-action="PurchaseHistory" class="rounded-lg px-3 py-2 font-label-md text-primary transition-colors hover:bg-secondary-container">Lịch sử</a>
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="rounded-lg px-3 py-2 font-label-md text-primary transition-colors hover:bg-secondary-container">Đăng xuất</button>
            </form>
        </div>
    </div>
</nav>

<aside class="fixed left-0 top-20 z-40 hidden h-[calc(100vh-5rem)] w-[280px] flex-col border-r border-outline-variant bg-surface-container-lowest p-gutter custom-shadow md:flex">
    <div class="mb-section-gap">
        <a asp-controller="Product" asp-action="Index" class="mb-10 flex items-center gap-3 rounded-lg transition hover:opacity-80">
            <partial name="_SakuraLogoMark" />
            <div>
                <p class="font-['Noto_Serif'] text-[22px] font-bold leading-none">
                    <span style="color:#3e2723">Coffe</span><span style="color:#81c784">-latte</span><span style="color:#f48fb1">Kawaii</span>
                </p>
                <p class="text-caption text-secondary">Admin Dashboard</p>
            </div>
        </a>
        <nav class="space-y-3">
            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="Product" asp-action="Add" class="flex items-center gap-3 rounded-lg px-4 py-3 font-label-md text-secondary transition hover:bg-surface-container">
                    <span class="material-symbols-outlined text-[18px]">inventory_2</span>
                    Thêm sản phẩm
                </a>
                <a asp-controller="Category" asp-action="Index" class="flex items-center gap-3 rounded-lg px-4 py-3 font-label-md text-secondary transition hover:bg-surface-container">
                    <span class="material-symbols-outlined text-[18px]">storefront</span>
                    Danh mục
                </a>
                <a asp-controller="Product" asp-action="UploadImageList" class="flex items-center gap-3 rounded-lg px-4 py-3 font-label-md text-secondary transition hover:bg-surface-container">
                    <span class="material-symbols-outlined text-[18px]">add_photo_alternate</span>
                    Ảnh & banner
                </a>
                <a asp-controller="Product" asp-action="Statistics" class="flex items-center gap-3 rounded-lg px-4 py-3 font-label-md text-secondary transition hover:bg-surface-container">
                    <span class="material-symbols-outlined text-[18px]">bar_chart</span>
                    Thống kê
                </a>
            }
            <a asp-controller="Account" asp-action="Profile" class="flex items-center gap-3 rounded-lg bg-primary px-4 py-3 font-label-md text-on-primary">
                <partial name="_UserAvatarIcon" />
                Trang cá nhân
            </a>
        </nav>
    </div>
    <div class="mt-auto border-t border-outline-variant pt-5">
        <div class="mb-4 flex items-center gap-3">
            <div class="h-10 w-10 overflow-hidden rounded-full border-2 border-primary-fixed bg-secondary-container">
                <img src="@avatarImage" alt="@Model.Profile.FullName" class="h-full w-full object-cover" />
            </div>
            <div>
                <p class="font-label-md text-primary">@Model.Profile.FullName</p>
                <p class="text-caption text-secondary">@roles</p>
            </div>
        </div>
        <form asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="flex w-full items-center justify-center gap-2 rounded-lg border border-error px-4 py-2 font-label-md text-error transition-colors hover:bg-error-container">
                <span class="material-symbols-outlined text-[18px]">logout</span>
                Đăng xuất
            </button>
        </form>
    </div>
</aside>

<main class="min-h-screen bg-background p-margin-mobile md:ml-[280px] md:p-margin-desktop">
    <header class="mx-auto mb-gutter flex max-w-container-max items-end justify-between">
        <div>
            <nav class="mb-2 flex items-center gap-2 text-caption text-secondary">
                <span>Admin</span>
                <span class="material-symbols-outlined text-[12px]">chevron_right</span>
                <span class="font-semibold text-primary">Trang cá nhân</span>
            </nav>
            <h1 class="font-headline-md text-primary">Quản lý tài khoản cá nhân</h1>
        </div>
        <div class="hidden md:block">
            <span class="text-caption font-medium uppercase tracking-widest text-secondary">@today</span>
        </div>
    </header>

    <section class="mx-auto grid max-w-container-max grid-cols-1 gap-gutter xl:grid-cols-12">
        <aside class="space-y-gutter xl:col-span-4">
            <div class="rounded-xl border border-outline-variant/20 bg-surface-container-lowest p-gutter custom-shadow">
                <div class="mb-5 overflow-hidden rounded-xl border border-outline-variant/20 bg-surface-container-low">
                    <div class="flex justify-center bg-surface-container-low p-5">
                        <div class="h-36 w-36 overflow-hidden rounded-full border-4 border-primary-fixed bg-secondary-container shadow-[0_10px_30px_rgba(62,39,35,0.08)]">
                            <img id="profileAvatarPreview" src="@avatarImage" alt="@Model.Profile.FullName" class="h-full w-full object-cover" />
                        </div>
                    </div>
                    <div class="space-y-3 p-4">
                        <form asp-action="UploadProfileBackground" method="post" enctype="multipart/form-data" class="space-y-3">
                            <label class="block text-caption text-secondary">Ảnh đại diện tài khoản</label>
                            <input id="profileAvatarInput" type="file" name="backgroundFile" class="w-full rounded-lg border border-outline-variant bg-white px-3 py-2 text-caption" accept=".jpg,.jpeg,.png,.webp" required />
                            <p class="text-caption text-secondary">Chọn tệp để xem trước, sau đó bấm xác nhận cập nhật.</p>
                            <button type="submit" class="flex w-full items-center justify-center gap-2 rounded-lg bg-secondary-container px-4 py-2 font-label-md text-on-secondary-container transition hover:bg-secondary hover:text-white">
                                <span class="material-symbols-outlined text-[18px]">wallpaper</span>
                                Xác nhận cập nhật ảnh
                            </button>
                        </form>
                        @if (!string.IsNullOrWhiteSpace(Model.ProfileBackgroundImageUrl))
                        {
                            <form asp-action="RemoveProfileBackground" method="post">
                                <button type="submit" class="flex w-full items-center justify-center gap-2 rounded-lg border border-error px-4 py-2 font-label-md text-error hover:bg-error-container">
                                    <span class="material-symbols-outlined text-[18px]">delete</span>
                                    Xóa ảnh đại diện
                                </button>
                            </form>
                        }
                    </div>
                </div>
                <div class="mb-6 flex items-center gap-4">
                    <div class="h-20 w-20 overflow-hidden rounded-full bg-primary">
                        <img src="@avatarImage" alt="@Model.Profile.FullName" class="h-full w-full object-cover" />
                    </div>
                    <div>
                        <p class="font-headline-md text-headline-md text-primary">@Model.Profile.FullName</p>
                        <p class="text-body-md text-secondary">@Model.Profile.Email</p>
                    </div>
                </div>
                <div class="grid grid-cols-1 gap-3">
                    <div class="rounded-lg bg-surface-container-low p-4">
                        <p class="text-caption text-secondary">Vai trò</p>
                        <p class="font-label-md text-primary">@roles</p>
                    </div>
                    <div class="rounded-lg bg-surface-container-low p-4">
                        <p class="text-caption text-secondary">Số đơn hàng</p>
                        <p class="font-label-md text-primary">@Model.OrderCount</p>
                    </div>
                    <div class="rounded-lg bg-surface-container-low p-4">
                        <p class="text-caption text-secondary">Tổng đã mua</p>
                        <p class="font-label-md text-primary">@Model.TotalSpent.ToString("N0", new CultureInfo("vi-VN")) VNĐ</p>
                    </div>
                    <div class="rounded-lg bg-surface-container-low p-4">
                        <p class="text-caption text-secondary">Đơn gần nhất</p>
                        <p class="font-label-md text-primary">@(Model.LastOrderAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Chưa có")</p>
                    </div>
                </div>
            </div>
        </aside>

        <section class="space-y-gutter xl:col-span-8">
            @if (TempData["ProfileSuccess"] is string profileOk)
            {
                <div class="rounded-lg border border-[#81c784] bg-[#eef8ef] px-4 py-3 text-sm text-primary">@profileOk</div>
            }
            @if (TempData["PasswordSuccess"] is string passwordOk)
            {
                <div class="rounded-lg border border-[#81c784] bg-[#eef8ef] px-4 py-3 text-sm text-primary">@passwordOk</div>
            }
            @if (TempData["EmailSuccess"] is string emailOk)
            {
                <div class="rounded-lg border border-[#81c784] bg-[#eef8ef] px-4 py-3 text-sm text-primary">@emailOk</div>
            }
            @if (TempData["EmailError"] is string emailErr)
            {
                <div class="rounded-lg border border-error bg-error-container px-4 py-3 text-sm text-on-error-container">@emailErr</div>
            }
            @if (TempData["ProfileError"] is string profileErr)
            {
                <div class="rounded-lg border border-error bg-error-container px-4 py-3 text-sm text-on-error-container">@profileErr</div>
            }

            <form asp-action="UpdateProfile" method="post" class="rounded-xl border border-outline-variant/20 bg-surface-container-lowest p-gutter custom-shadow">
                <h2 class="mb-6 flex items-center gap-2 font-label-md text-primary">
                    <span class="material-symbols-outlined text-[20px]">badge</span>
                    Thông tin tài khoản
                </h2>
                <div asp-validation-summary="All" class="mb-5 rounded-lg bg-error-container px-4 py-3 text-sm text-on-error-container"></div>
                <div class="grid grid-cols-1 gap-gutter md:grid-cols-2">
                    <div>
                        <label asp-for="Profile.UserName" class="mb-2 block font-label-md text-secondary">UserName</label>
                        <input asp-for="Profile.UserName" class="w-full rounded-lg border border-outline-variant bg-white px-4 py-3 text-body-md outline-none focus:border-primary focus:ring-1 focus:ring-primary" />
                        <span asp-validation-for="Profile.UserName" class="mt-1 block text-sm text-error"></span>
                    </div>
                    <div>
                        <label asp-for="Profile.Email" class="mb-2 block font-label-md text-secondary">Email</label>
                        <input asp-for="Profile.Email" readonly class="w-full rounded-lg border border-outline-variant bg-surface-container-low px-4 py-3 text-body-md text-secondary outline-none" />
                    </div>
                    <div>
                        <label asp-for="Profile.FullName" class="mb-2 block font-label-md text-secondary">Họ và tên</label>
                        <input asp-for="Profile.FullName" class="w-full rounded-lg border border-outline-variant bg-white px-4 py-3 text-body-md outline-none focus:border-primary focus:ring-1 focus:ring-primary" />
                        <span asp-validation-for="Profile.FullName" class="mt-1 block text-sm text-error"></span>
                    </div>
                    <div>
                        <label asp-for="Profile.PhoneNumber" class="mb-2 block font-label-md text-secondary">Số điện thoại</label>
                        <input asp-for="Profile.PhoneNumber" class="w-full rounded-lg border border-outline-variant bg-white px-4 py-3 text-body-md outline-none focus:border-primary focus:ring-1 focus:ring-primary" />
                        <span asp-validation-for="Profile.PhoneNumber" class="mt-1 block text-sm text-error"></span>
                    </div>
                    <div class="md:col-span-2">
                        <label asp-for="Profile.Address" class="mb-2 block font-label-md text-secondary">Địa chỉ</label>
                        <textarea asp-for="Profile.Address" rows="3" class="w-full resize-none rounded-lg border border-outline-variant bg-white px-4 py-3 text-body-md outline-none focus:border-primary focus:ring-1 focus:ring-primary"></textarea>
                        <span asp-validation-for="Profile.Address" class="mt-1 block text-sm text-error"></span>
                    </div>
                </div>
                <button type="submit" class="mt-6 inline-flex items-center gap-2 rounded-xl bg-primary px-6 py-3 font-label-md text-on-primary shadow-lg">
                    <span class="material-symbols-outlined text-[20px]">save</span>
                    Lưu thông tin
                </button>
            </form>

            <div class="rounded-xl border border-outline-variant/20 bg-surface-container-lowest p-gutter custom-shadow">
                <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
                    <h2 class="flex items-center gap-2 font-label-md text-primary">
                        <span class="material-symbols-outlined text-[20px]">mark_email_read</span>
                        Xác thực Gmail
                    </h2>
                    <span class="rounded-full px-3 py-1 text-caption font-bold @emailStatusClass">@emailStatusText</span>
                </div>

                <div class="mb-5 rounded-lg bg-surface-container-low p-4">
                    <p class="text-caption text-secondary">Gmail hiện tại</p>
                    <p class="font-label-md text-primary">@Model.Profile.Email</p>
                    @if (!string.IsNullOrWhiteSpace(Model.PendingEmail))
                    {
                        <p class="mt-2 text-caption text-secondary">Đang chờ xác thực: <span class="font-semibold text-primary">@Model.PendingEmail</span></p>
                    }
                </div>

                <form asp-action="SendEmailVerification" method="post" class="grid grid-cols-1 gap-gutter md:grid-cols-[1fr_auto]">
                    <div>
                        <label asp-for="EmailChange.NewEmail" class="mb-2 block font-label-md text-secondary">Gmail mới hoặc Gmail cần xác thực</label>
                        <input asp-for="EmailChange.NewEmail" class="w-full rounded-lg border border-outline-variant bg-white px-4 py-3 text-body-md outline-none focus:border-primary focus:ring-1 focus:ring-primary" />
                        <span asp-validation-for="EmailChange.NewEmail" class="mt-1 block text-sm text-error"></span>
                    </div>
                    <div class="flex items-end">
                        <button id="sendEmailCodeBtn" type="submit" data-cooldown="@Model.EmailCodeCooldownSeconds" class="w-full rounded-xl bg-primary px-6 py-3 font-label-md text-on-primary shadow-lg disabled:cursor-not-allowed disabled:opacity-60">
                            Gửi mã xác thực
                        </button>
                    </div>
                </form>

                <form asp-action="VerifyEmailCode" method="post" class="mt-gutter grid grid-cols-1 gap-gutter md:grid-cols-[1fr_auto]">
                    <input asp-for="EmailChange.NewEmail" type="hidden" />
                    <div>
                        <label asp-for="EmailChange.VerificationCode" class="mb-2 block font-label-md text-secondary">Mã xác thực 6 số</label>
                        <input asp-for="EmailChange.VerificationCode" class="w-full rounded-lg border border-outline-variant bg-white px-4 py-3 text-body-md outline-none focus:border-primary focus:ring-1 focus:ring-primary" placeholder="Nhập mã từ Gmail" />
                        <span asp-validation-for="EmailChange.VerificationCode" class="mt-1 block text-sm text-error"></span>
                    </div>
                    <div class="flex items-end">
                        <button type="submit" class="w-full rounded-xl border border-primary px-6 py-3 font-label-md text-primary transition hover:bg-primary hover:text-on-primary">
                            Xác nhận Gmail
                        </button>
                    </div>
                </form>
            </div>

            <form asp-action="ChangePassword" method="post" class="rounded-xl border border-outline-variant/20 bg-surface-container-lowest p-gutter custom-shadow">
                <h2 class="mb-6 flex items-center gap-2 font-label-md text-primary">
                    <span class="material-symbols-outlined text-[20px]">lock_reset</span>
                    Đổi mật khẩu
                </h2>
                <div asp-validation-summary="All" class="mb-5 rounded-lg bg-error-container px-4 py-3 text-sm text-on-error-container"></div>
                <div class="grid grid-cols-1 gap-gutter md:grid-cols-3">
                    <div>
                        <label asp-for="Password.CurrentPassword" class="mb-2 block font-label-md text-secondary">Mật khẩu hiện tại</label>
                        <input asp-for="Password.CurrentPassword" class="w-full rounded-lg border border-outline-variant bg-white px-4 py-3 text-body-md outline-none focus:border-primary focus:ring-1 focus:ring-primary" />
                        <span asp-validation-for="Password.CurrentPassword" class="mt-1 block text-sm text-error"></span>
                    </div>
                    <div>
                        <label asp-for="Password.NewPassword" class="mb-2 block font-label-md text-secondary">Mật khẩu mới</label>
                        <input asp-for="Password.NewPassword" class="w-full rounded-lg border border-outline-variant bg-white px-4 py-3 text-body-md outline-none focus:border-primary focus:ring-1 focus:ring-primary" />
                        <span asp-validation-for="Password.NewPassword" class="mt-1 block text-sm text-error"></span>
                    </div>
                    <div>
                        <label asp-for="Password.ConfirmPassword" class="mb-2 block font-label-md text-secondary">Xác nhận mật khẩu</label>
                        <input asp-for="Password.ConfirmPassword" class="w-full rounded-lg border border-outline-variant bg-white px-4 py-3 text-body-md outline-none focus:border-primary focus:ring-1 focus:ring-primary" />
                        <span asp-validation-for="Password.ConfirmPassword" class="mt-1 block text-sm text-error"></span>
                    </div>
                </div>
                <button type="submit" class="mt-6 inline-flex items-center gap-2 rounded-xl border border-primary px-6 py-3 font-label-md text-primary transition hover:bg-primary hover:text-on-primary">
                    <span class="material-symbols-outlined text-[20px]">vpn_key</span>
                    Cập nhật mật khẩu
                </button>
            </form>
        </section>
    </section>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const button = document.getElementById('sendEmailCodeBtn');
            if (!button) return;

            let remaining = Number(button.dataset.cooldown || 0);
            const originalText = button.textContent.trim();
            const render = () => {
                if (remaining <= 0) {
                    button.disabled = false;
                    button.textContent = originalText;
                    return;
                }

                button.disabled = true;
                button.textContent = `Chờ ${remaining}s`;
                remaining -= 1;
                window.setTimeout(render, 1000);
            };

            render();

            const avatarInput = document.getElementById('profileAvatarInput');
            const avatarPreview = document.getElementById('profileAvatarPreview');
            avatarInput?.addEventListener('change', () => {
                const file = avatarInput.files?.[0];
                if (!file || !avatarPreview) return;

                avatarPreview.src = URL.createObjectURL(file);
            });
        })();
    </script>
}



