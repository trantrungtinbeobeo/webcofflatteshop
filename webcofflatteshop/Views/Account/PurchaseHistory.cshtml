@model webcofflatteshop.Models.PurchaseHistoryViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Lịch sử đơn hàng";
    var vi = new CultureInfo("vi-VN");
    var orders = (Model.Orders ?? Enumerable.Empty<webcofflatteshop.Models.Order>())
        .OrderByDescending(order => order.CreatedAt)
        .ToList();
    var totalSpent = Model.IsAdmin
        ? orders.Where(order => order.Status == "Completed").Sum(order => order.TotalAmount)
        : orders.Sum(order => order.TotalAmount);
    var totalItems = orders.Sum(order => order.Items.Sum(item => item.Quantity));
    var latestOrder = orders.FirstOrDefault();
    var pendingOrders = orders.Count(order => order.Status != "Completed");

    string Money(decimal value) => value.ToString("N0", vi) + " VNĐ";
    string OrderCode(int id) => $"#DH{id:00000}";
    string StatusText(string? status) => status == "Completed" ? "Hoàn thành" : status == "Preparing" ? "Đang pha chế" : status == "Delivering" ? "Đang giao" : "Chờ xử lý";
    string StatusIcon(string? status) => status == "Completed" ? "check_circle" : status == "Preparing" ? "local_cafe" : status == "Delivering" ? "local_shipping" : "schedule";
    int StatusStep(string? status) => status == "Completed" ? 4 : status == "Delivering" ? 3 : status == "Preparing" ? 2 : 1;
    int StatusPercent(string? status) => StatusStep(status) * 25;
    string StatusColor(string? status) => status == "Completed" ? "#2e7d32" : status == "Delivering" ? "#8a6a24" : status == "Preparing" ? "#745853" : "#d9a441";
}

<header class="sticky top-0 z-50 bg-surface shadow-[0_10px_30px_rgba(62,39,35,0.05)]">
    <nav class="mx-auto flex h-20 w-full max-w-container-max items-center justify-between px-margin-mobile py-unit md:px-margin-desktop">
        <a asp-controller="Product" asp-action="Index" class="flex items-center gap-2">
            <partial name="_SakuraLogoMark" />
            <span class="font-display-lg text-headline-md text-primary tracking-tight">
                <span class="text-primary">Coffe</span>
                <span style="color:#81c784">Latte</span>
                <span style="color:#f48fb1">Kawaii</span>
            </span>
        </a>

        <div class="hidden items-center gap-10 md:flex">
            <a asp-controller="Product" asp-action="Index" class="font-body-md text-secondary transition-colors duration-200 hover:text-primary">Menu</a>
            <a asp-controller="Account" asp-action="PurchaseHistory" class="font-body-md border-b-2 border-primary pb-1 text-primary">Lịch sử đơn hàng</a>
        </div>

        <div class="flex items-center gap-4 md:gap-6">
            <partial name="_UserAvatarHeader" />
            <div class="relative hidden sm:block">
                <input id="historySearch" class="w-48 rounded-full border-outline-variant bg-surface-container-low px-5 py-2 text-body-md transition-all focus:w-64 focus:border-primary focus:ring-primary" placeholder="Tìm đơn hàng..." type="text" />
                <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-outline">search</span>
            </div>
            <a asp-controller="Product" asp-action="Index" class="relative text-primary transition-transform active:scale-95" aria-label="Giỏ hàng">
                <span class="material-symbols-outlined">shopping_cart</span>
            </a>
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="rounded-lg border border-outline-variant px-3 py-2 font-label-md text-secondary transition hover:bg-surface-container hover:text-error">Đăng xuất</button>
            </form>
        </div>
    </nav>
</header>

<main class="mx-auto max-w-[900px] px-margin-mobile py-12 md:px-0">
    <section class="mb-10 text-center md:text-left">
        <div class="mb-4 inline-flex items-center gap-2 rounded-full bg-secondary-container px-4 py-1 text-on-secondary-container">
            <span class="h-2 w-2 rounded-full bg-[#6a8e4e]"></span>
            <span class="font-label-md text-[12px] uppercase tracking-widest">@(Model.IsAdmin ? "Tài khoản admin" : "Tài khoản cá nhân")</span>
        </div>
        <h1 class="mb-2 font-display-lg text-display-lg text-primary">Lịch sử đơn hàng</h1>
        <p class="font-body-lg text-secondary">@(Model.IsAdmin ? "Theo dõi tiến trình đơn hàng của khách tại Coffe Latte Kawaii." : "Xem lại những đơn hàng bạn đã đặt tại Coffe Latte Kawaii.")</p>
    </section>

    <section id="orderRealtimeNotice" class="mb-8 flex items-center justify-between gap-4 rounded-xl border border-outline-variant/20 bg-surface-container-lowest p-4 shadow-[0_4px_20px_rgba(62,39,35,0.03)]">
        <div class="flex items-center gap-3">
            <div class="relative flex h-12 w-12 items-center justify-center rounded-full bg-secondary-container text-primary">
                <span id="orderRealtimeIcon" class="material-symbols-outlined">@(StatusIcon(latestOrder?.Status))</span>
                <span id="orderRealtimeBadge" class="absolute -right-1 -top-1 flex h-6 min-w-6 items-center justify-center rounded-full bg-primary px-1 text-[11px] font-bold text-on-primary">@pendingOrders</span>
            </div>
            <div>
                <p class="font-label-md text-primary">Theo dõi đơn hàng</p>
                <p id="orderRealtimeText" class="text-caption text-secondary">
                    @(latestOrder is null
                        ? "Chưa có đơn hàng nào để theo dõi."
                        : Model.IsAdmin
                            ? $"Hiện có {pendingOrders} đơn hàng đang cần xử lý."
                            : $"Đơn gần nhất {OrderCode(latestOrder.Id)} đang ở trạng thái {StatusText(latestOrder.Status).ToLower(vi)}.")
                </p>
            </div>
        </div>
        <span class="hidden rounded-full bg-secondary-container px-3 py-1 text-caption font-semibold text-on-secondary-container sm:inline-flex">Real time 5s</span>
    </section>

    @if (Model.IsAdmin)
    {
        <section id="adminOrderNotice" class="mb-8 flex items-center justify-between gap-4 rounded-xl border border-outline-variant/20 bg-surface-container-lowest p-4 shadow-[0_4px_20px_rgba(62,39,35,0.03)]">
            <div class="flex items-center gap-3">
                <div class="relative flex h-12 w-12 items-center justify-center rounded-full bg-secondary-container text-primary">
                    <span class="material-symbols-outlined">notifications</span>
                    <span id="adminPendingBadge" class="absolute -right-1 -top-1 flex h-6 min-w-6 items-center justify-center rounded-full bg-primary px-1 text-[11px] font-bold text-on-primary">@pendingOrders</span>
                </div>
                <div>
                    <p class="font-label-md text-primary">Thông báo đơn hàng</p>
                    <p id="adminOrderNoticeText" class="text-caption text-secondary">Hiện có @pendingOrders đơn hàng đang cần theo dõi.</p>
                </div>
            </div>
            <span class="hidden rounded-full bg-secondary-container px-3 py-1 text-caption font-semibold text-on-secondary-container sm:inline-flex">Real time 5s</span>
        </section>
    }

    <section class="mb-8 grid grid-cols-1 gap-gutter md:grid-cols-3">
        <div class="rounded-xl border border-outline-variant/20 bg-surface-container-lowest p-5 shadow-[0_4px_20px_rgba(62,39,35,0.03)]">
            <p class="text-caption text-secondary">Tổng đơn hàng</p>
            <p class="mt-2 font-headline-md text-headline-md text-primary">@orders.Count</p>
        </div>
        <div class="rounded-xl border border-outline-variant/20 bg-surface-container-lowest p-5 shadow-[0_4px_20px_rgba(62,39,35,0.03)]">
            <p class="text-caption text-secondary">Sản phẩm trong đơn</p>
            <p class="mt-2 font-headline-md text-headline-md text-primary">@totalItems</p>
        </div>
        <div class="rounded-xl border border-outline-variant/20 bg-surface-container-lowest p-5 shadow-[0_4px_20px_rgba(62,39,35,0.03)]">
            <p class="text-caption text-secondary">@(Model.IsAdmin ? "Tổng doanh thu" : "Tổng chi tiêu")</p>
            <p class="mt-2 font-headline-md text-headline-md text-primary">@Money(totalSpent)</p>
        </div>
    </section>

    <section class="mb-8 flex flex-col gap-3 rounded-xl border border-outline-variant/20 bg-surface-container-lowest p-4 shadow-[0_4px_20px_rgba(62,39,35,0.03)] sm:flex-row sm:items-center sm:justify-between">
        <div class="relative sm:hidden">
            <input id="historySearchMobile" class="w-full rounded-full border-outline-variant bg-surface-container-low px-5 py-2 text-body-md focus:border-primary focus:ring-primary" placeholder="Tìm đơn hàng..." type="text" />
            <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-outline">search</span>
        </div>
        <div class="flex flex-wrap gap-2">
            <button class="history-filter rounded-full bg-primary px-4 py-2 font-label-md text-on-primary" data-filter="all" type="button">Tất cả</button>
            <button class="history-filter rounded-full bg-secondary-container px-4 py-2 font-label-md text-on-secondary-container" data-filter="completed" type="button">Hoàn thành</button>
            <button class="history-filter rounded-full bg-secondary-container px-4 py-2 font-label-md text-on-secondary-container" data-filter="pending" type="button">Chờ xử lý</button>
            <button class="history-filter rounded-full bg-secondary-container px-4 py-2 font-label-md text-on-secondary-container" data-filter="today" type="button">Hôm nay</button>
        </div>
        @if (latestOrder is not null)
        {
            <p class="text-caption text-secondary">Đơn gần nhất: @OrderCode(latestOrder.Id)</p>
        }
    </section>

    @if (!orders.Any())
    {
        <section class="rounded-xl border border-outline-variant/20 bg-surface-container-lowest p-gutter text-center shadow-[0_4px_20px_rgba(62,39,35,0.03)]">
            <span class="material-symbols-outlined mb-4 text-[48px] text-outline">receipt_long</span>
            <h2 class="mb-2 font-headline-md text-primary">Bạn chưa có đơn hàng nào</h2>
            <p class="mb-6 text-body-md text-secondary">Khi có đơn đặt hàng, lịch sử đơn hàng sẽ xuất hiện tại đây.</p>
            <a asp-controller="Product" asp-action="Index" class="inline-flex rounded-lg bg-primary px-6 py-3 font-label-md text-on-primary">Khám phá menu</a>
        </section>
    }
    else
    {
        <div id="orderList" class="flex flex-col gap-6">
            @foreach (var order in orders)
            {
                var localCreatedAt = order.CreatedAt.ToLocalTime();
                var itemSummary = string.Join(", ", order.Items.Select(item => $"{item.ProductName} ({item.Size}) x{item.Quantity}"));
                var searchableText = $"{OrderCode(order.Id)} {itemSummary} {localCreatedAt:dd/MM/yyyy}";
                var status = string.IsNullOrWhiteSpace(order.Status) ? "Pending" : order.Status;
                var statusText = StatusText(status);
                var statusStep = StatusStep(status);
                var progressPercent = StatusPercent(status);
                var progressColor = StatusColor(status);
                var filterStatus = status == "Completed" ? "completed" : "pending";
                <article class="order-card-hover order-card rounded-xl border border-outline-variant/20 bg-surface-container-lowest p-6 shadow-[0_4px_20px_rgba(62,39,35,0.03)] transition-all duration-300"
                         id="order-@order.Id"
                         data-order-id="@order.Id"
                         data-order="@searchableText"
                         data-status="@filterStatus"
                         data-date="@localCreatedAt.ToString("yyyy-MM-dd")">
                    <div class="mb-6 flex flex-col items-start justify-between gap-4 border-b border-surface-container-high pb-6 md:flex-row md:items-center">
                        <div>
                            <div class="mb-1 flex flex-wrap items-center gap-3">
                                <span class="font-headline-md text-headline-md text-primary">@OrderCode(order.Id)</span>
                                <span class="order-status-badge rounded-full bg-secondary-container px-3 py-1 font-label-md text-caption text-on-secondary-container">@statusText</span>
                            </div>
                            <p class="flex items-center gap-2 font-body-md text-secondary">
                                <span class="material-symbols-outlined text-[18px]">calendar_today</span>
                                @localCreatedAt.ToString("dd/MM/yyyy HH:mm", vi)
                            </p>
                            <p class="mt-1 text-caption text-secondary">
                                @(order.FulfillmentMethod == "Delivery" ? "Giao tận nhà trong bán kính 1km" : "Nhận thức uống tại cửa hàng")
                            </p>
                        </div>
                        <div class="w-full text-left md:w-auto md:text-right">
                            <p class="mb-1 font-body-md text-secondary">Tổng cộng</p>
                            <p class="font-headline-md text-headline-md text-primary">@Money(order.TotalAmount)</p>
                        </div>
                    </div>

                    <div class="flex flex-col items-end justify-between gap-6 md:flex-row">
                        <div class="flex-1">
                            <p class="mb-2 font-label-md text-on-surface-variant">Sản phẩm trong đơn</p>
                            <p class="font-body-md leading-relaxed text-secondary">@itemSummary</p>
                            <div class="order-progress mt-5 rounded-xl border border-outline-variant/20 bg-surface-container-lowest p-4"
                                 data-progress-order-id="@order.Id"
                                 data-progress-status="@status">
                                <div class="mb-4 flex items-center justify-between">
                                    <p class="text-caption font-semibold uppercase tracking-widest text-secondary">Tiến trình đơn hàng</p>
                                    <span class="order-progress-label rounded-full px-3 py-1 text-caption font-bold text-white" style="background-color:@progressColor">@statusText</span>
                                </div>
                                <div class="relative">
                                    <div class="absolute left-0 right-0 top-5 h-1 rounded-full bg-surface-container-high"></div>
                                    <div class="order-progress-fill absolute left-0 top-5 h-1 rounded-full transition-all duration-700" style="width:@progressPercent%; background-color:@progressColor"></div>
                                    <div class="relative grid grid-cols-4 gap-2">
                                        @{
                                            var stepLabels = new[] { "Chờ xử lý", "Đang pha chế", "Đang giao", "Hoàn thành" };
                                            var stepIcons = new[] { "schedule", "local_cafe", "local_shipping", "check_circle" };
                                        }
                                        @for (var stepIndex = 0; stepIndex < stepLabels.Length; stepIndex++)
                                        {
                                            var stepNumber = stepIndex + 1;
                                            var isActiveStep = stepNumber <= statusStep;
                                            <div class="text-center">
                                                <span class="order-progress-icon mx-auto flex h-11 w-11 items-center justify-center rounded-full border-2 transition-all duration-500 @(isActiveStep ? "border-transparent text-white" : "border-outline-variant bg-surface-container-lowest text-secondary")" data-step="@stepNumber" style="@(isActiveStep ? $"background-color:{progressColor}" : "")">
                                                    <span class="material-symbols-outlined text-[20px]">@stepIcons[stepIndex]</span>
                                                </span>
                                                <span class="mt-2 block text-[11px] font-semibold leading-4 @(isActiveStep ? "text-primary" : "text-secondary")">@stepLabels[stepIndex]</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                            @if (Model.IsAdmin)
                            {
                                <div class="mt-4 grid grid-cols-4 gap-2 text-center text-[11px] font-semibold text-secondary">
                                    <span class="rounded-full @(status == "Pending" ? "bg-primary text-on-primary" : "bg-surface-container") px-2 py-1">Chờ</span>
                                    <span class="rounded-full @(status == "Preparing" ? "bg-primary text-on-primary" : "bg-surface-container") px-2 py-1">Pha chế</span>
                                    <span class="rounded-full @(status == "Delivering" ? "bg-primary text-on-primary" : "bg-surface-container") px-2 py-1">Giao</span>
                                    <span class="rounded-full @(status == "Completed" ? "bg-primary text-on-primary" : "bg-surface-container") px-2 py-1">Xong</span>
                                </div>
                            }
                        </div>
                        <button class="order-detail-toggle flex whitespace-nowrap rounded-lg bg-primary-container px-6 py-3 font-label-md text-on-primary-container transition-all hover:bg-primary hover:text-white" type="button">
                            Xem chi tiết
                            <span class="material-symbols-outlined ml-2 text-[18px]">arrow_forward</span>
                        </button>
                    </div>

                    <div class="order-detail mt-6 hidden rounded-lg bg-surface-container-low p-4">
                        <div class="divide-y divide-outline-variant/20">
                            @foreach (var item in order.Items)
                            {
                                <div class="grid grid-cols-1 gap-2 py-3 md:grid-cols-[1fr_auto]">
                                    <div>
                                        <p class="font-label-md text-primary">@item.ProductName</p>
                                        <p class="text-caption text-secondary">Size: @item.Size | Đường: @item.Sugar | Số lượng: @item.Quantity</p>
                                    </div>
                                    <p class="font-body-md text-primary">@Money(item.LineTotal)</p>
                                </div>
                            }
                        </div>
                        <div class="mt-4 flex flex-wrap gap-3">
                            <a asp-controller="Product" asp-action="Index" class="rounded-lg border border-outline-variant px-4 py-2 font-label-md text-secondary transition hover:bg-surface-container">Mua thêm món</a>
                            <button type="button" class="rounded-lg bg-secondary-container px-4 py-2 font-label-md text-on-secondary-container" onclick="window.print()">In lịch sử</button>
                        </div>
                        <div class="mt-4 rounded-lg bg-surface-container-lowest p-3 text-caption text-secondary">
                            Tạm tính: @Money(order.SubtotalAmount > 0 ? order.SubtotalAmount : order.TotalAmount - order.ShippingFee) |
                            Ship: @Money(order.ShippingFee) |
                            Tổng: @Money(order.TotalAmount)
                        </div>
                        @if (Model.IsAdmin)
                        {
                            <form asp-controller="Account" asp-action="UpdateOrderStatus" method="post" class="ajax-order-status-form mt-4 flex flex-wrap gap-2">
                                <input type="hidden" name="orderId" value="@order.Id" />
                                <button name="status" value="Pending" class="rounded-lg border border-outline-variant px-3 py-2 text-caption font-semibold text-secondary hover:bg-surface-container" type="submit">Chờ xử lý</button>
                                <button name="status" value="Preparing" class="rounded-lg border border-outline-variant px-3 py-2 text-caption font-semibold text-secondary hover:bg-surface-container" type="submit">Đang pha chế</button>
                                <button name="status" value="Delivering" class="rounded-lg border border-outline-variant px-3 py-2 text-caption font-semibold text-secondary hover:bg-surface-container" type="submit">Đang giao</button>
                                <button name="status" value="Completed" class="rounded-lg bg-primary px-3 py-2 text-caption font-semibold text-on-primary" type="submit">Hoàn thành</button>
                            </form>
                        }
                    </div>
                </article>
            }
        </div>

        <p id="historyEmptyFilter" class="mt-8 hidden rounded-xl border border-outline-variant/20 bg-surface-container-lowest p-6 text-center text-secondary">
            Không tìm thấy đơn hàng phù hợp.
        </p>

        <div class="mt-12 flex items-center justify-center gap-4">
            <button class="flex h-10 w-10 items-center justify-center rounded-full border border-outline-variant text-secondary opacity-30" disabled>
                <span class="material-symbols-outlined">chevron_left</span>
            </button>
            <span class="font-label-md text-primary">Trang 1 / 1</span>
            <button class="flex h-10 w-10 items-center justify-center rounded-full border border-outline-variant text-secondary opacity-30" disabled>
                <span class="material-symbols-outlined">chevron_right</span>
            </button>
        </div>
    }
</main>

<footer class="mt-section-gap flex w-full flex-col items-center gap-gutter border-t border-outline-variant/10 bg-surface-container px-margin-mobile py-section-gap md:px-margin-desktop">
    <div class="grid w-full max-w-container-max grid-cols-1 gap-12 md:grid-cols-4">
        <div class="md:col-span-2">
            <span class="mb-4 block font-display-lg text-display-lg text-primary">
                <span class="text-primary">Coffe</span>
                <span style="color:#81c784">Latte</span>
                <span style="color:#f48fb1">Kawaii</span>
            </span>
            <p class="max-w-md font-body-md leading-relaxed text-secondary">Sự giao thoa tinh tế giữa nét ấm áp của Sài Gòn và sự tĩnh lặng, tỉ mỉ của Cố đô Kyoto.</p>
        </div>
        <div>
            <h4 class="mb-6 font-label-md uppercase tracking-wider text-primary">Khám phá</h4>
            <ul class="flex flex-col gap-4 font-body-md text-secondary">
                <li><a asp-controller="Product" asp-action="Index" class="transition-colors hover:text-primary">Thực đơn đặc sắc</a></li>
                <li><a asp-controller="Account" asp-action="PurchaseHistory" class="transition-colors hover:text-primary">Lịch sử đơn hàng</a></li>
            </ul>
        </div>
        <div>
            <h4 class="mb-6 font-label-md uppercase tracking-wider text-primary">Hỗ trợ</h4>
            <ul class="flex flex-col gap-4 font-body-md text-secondary">
                <li><a href="#" class="transition-colors hover:text-primary">Privacy Policy</a></li>
                <li><a href="#" class="transition-colors hover:text-primary">Contact Us</a></li>
            </ul>
        </div>
    </div>
    <div class="flex w-full max-w-container-max flex-col items-center justify-between gap-4 border-t border-outline-variant/20 pt-8 md:flex-row">
        <p class="font-caption text-secondary">© 2026 Coffe Latte Kawaii. A Saigon-Kyoto Fusion.</p>
        <div class="flex gap-6 text-secondary">
            <span class="material-symbols-outlined">social_leaderboard</span>
            <span class="material-symbols-outlined">camera_alt</span>
            <span class="material-symbols-outlined">coffee</span>
        </div>
    </div>
</footer>

<script>
(() => {
    const cards = Array.from(document.querySelectorAll('.order-card'));
    const searchInputs = [document.getElementById('historySearch'), document.getElementById('historySearchMobile')].filter(Boolean);
    const emptyFilter = document.getElementById('historyEmptyFilter');
    let activeFilter = 'all';

    const today = new Date().toISOString().slice(0, 10);

    const applyFilters = () => {
        const keyword = (searchInputs[0]?.value || '').trim().toLowerCase();
        let visibleCount = 0;

        cards.forEach(card => {
            const haystack = (card.dataset.order || '').toLowerCase();
            const matchesSearch = !keyword || haystack.includes(keyword);
            const matchesFilter = activeFilter === 'all'
                || (activeFilter === 'today' && card.dataset.date === today)
                || card.dataset.status === activeFilter;
            const shouldShow = matchesSearch && matchesFilter;
            card.classList.toggle('hidden', !shouldShow);
            if (shouldShow) visibleCount++;
        });

        emptyFilter?.classList.toggle('hidden', visibleCount > 0);
    };

    searchInputs.forEach(input => {
        input.addEventListener('input', () => {
            searchInputs.forEach(other => {
                if (other !== input) other.value = input.value;
            });
            applyFilters();
        });
    });

    document.querySelectorAll('.history-filter').forEach(button => {
        button.addEventListener('click', () => {
            activeFilter = button.dataset.filter || 'all';
            document.querySelectorAll('.history-filter').forEach(item => {
                item.classList.toggle('bg-primary', item === button);
                item.classList.toggle('text-on-primary', item === button);
                item.classList.toggle('bg-secondary-container', item !== button);
                item.classList.toggle('text-on-secondary-container', item !== button);
            });
            applyFilters();
        });
    });

    document.querySelectorAll('.order-detail-toggle').forEach(button => {
        button.addEventListener('click', () => {
            const detail = button.closest('.order-card')?.querySelector('.order-detail');
            if (!detail) return;
            detail.classList.toggle('hidden');
        });
    });

    document.querySelectorAll('.order-card-hover').forEach(card => {
        card.addEventListener('mouseenter', () => {
            card.style.borderColor = 'rgba(106, 142, 78, 0.4)';
        });
        card.addEventListener('mouseleave', () => {
            card.style.borderColor = 'rgba(210, 180, 140, 0.2)';
        });
    });

    const focusRequestedOrder = () => {
        const queryOrderId = Number(new URLSearchParams(window.location.search).get('focusOrderId') || 0);
        const hashOrderId = Number((window.location.hash.match(/^#order-(\d+)$/) || [])[1] || 0);
        const focusOrderId = queryOrderId || hashOrderId;
        if (!focusOrderId) return;

        const focusedCard = document.querySelector(`[data-order-id="${focusOrderId}"]`);
        if (!focusedCard) return;

        activeFilter = 'all';
        searchInputs.forEach(input => input.value = '');
        document.querySelectorAll('.history-filter').forEach(item => {
            const isAll = item.dataset.filter === 'all';
            item.classList.toggle('bg-primary', isAll);
            item.classList.toggle('text-on-primary', isAll);
            item.classList.toggle('bg-secondary-container', !isAll);
            item.classList.toggle('text-on-secondary-container', !isAll);
        });
        applyFilters();
        window.setTimeout(() => {
            focusedCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
            focusedCard.classList.add('order-focus-highlight');
            window.setTimeout(() => focusedCard.classList.remove('order-focus-highlight'), 3000);
        }, 150);
    };

    focusRequestedOrder();

    const statusMeta = {
        Pending: { text: 'Chờ xử lý', icon: 'schedule', color: '#d9a441', step: 1 },
        Preparing: { text: 'Đang pha chế', icon: 'local_cafe', color: '#745853', step: 2 },
        Delivering: { text: 'Đang giao', icon: 'local_shipping', color: '#8a6a24', step: 3 },
        Completed: { text: 'Hoàn thành', icon: 'check_circle', color: '#2e7d32', step: 4 }
    };
    const orderRealtimeIcon = document.getElementById('orderRealtimeIcon');
    const orderRealtimeBadge = document.getElementById('orderRealtimeBadge');
    const orderRealtimeText = document.getElementById('orderRealtimeText');
    const isAdmin = @Json.Serialize(Model.IsAdmin);
    const adminPendingBadge = document.getElementById('adminPendingBadge');
    const adminOrderNoticeText = document.getElementById('adminOrderNoticeText');
    let latestSeenOrderId = @Json.Serialize(latestOrder?.Id);
    const orderStatusCache = new Map(cards.map(card => [Number(card.dataset.orderId), card.querySelector('[data-progress-order-id]')?.dataset.progressStatus || 'Pending']));
    const setOrderProgress = (orderId, status) => {
        const meta = statusMeta[status] || statusMeta.Pending;
        const card = document.querySelector(`[data-order-id="${orderId}"]`);
        const progress = document.querySelector(`[data-progress-order-id="${orderId}"]`);
        if (!card || !progress) return;

        progress.dataset.progressStatus = status;
        card.dataset.status = status === 'Completed' ? 'completed' : 'pending';
        card.querySelector('.order-status-badge')?.replaceChildren(document.createTextNode(meta.text));

        const label = progress.querySelector('.order-progress-label');
        const fill = progress.querySelector('.order-progress-fill');
        if (label) {
            label.textContent = meta.text;
            label.style.backgroundColor = meta.color;
        }
        if (fill) {
            fill.style.width = `${meta.step * 25}%`;
            fill.style.backgroundColor = meta.color;
        }

        progress.querySelectorAll('.order-progress-icon').forEach(icon => {
            const step = Number(icon.dataset.step);
            const isActive = step <= meta.step;
            icon.classList.toggle('border-transparent', isActive);
            icon.classList.toggle('text-white', isActive);
            icon.classList.toggle('border-outline-variant', !isActive);
            icon.classList.toggle('bg-surface-container-lowest', !isActive);
            icon.classList.toggle('text-secondary', !isActive);
            icon.style.backgroundColor = isActive ? meta.color : '';
        });
    };

    let orderPollInFlight = false;
    const pollOrderRealtime = async () => {
        if (document.hidden || orderPollInFlight) return;
        orderPollInFlight = true;
        try {
            const response = await fetch('/Account/OrderRealtimeSummary', { cache: 'no-store' });
            if (!response.ok) return;
            const data = await response.json();
            if (orderRealtimeBadge) orderRealtimeBadge.textContent = data.activeCount ?? 0;
            if (adminPendingBadge) adminPendingBadge.textContent = data.activeCount ?? 0;
            const activeMeta = statusMeta[data.latestActiveStatus] || statusMeta.Pending;
            if (orderRealtimeIcon) orderRealtimeIcon.textContent = activeMeta.icon;
            if (orderRealtimeText) {
                if ((data.totalCount ?? 0) === 0) {
                    orderRealtimeText.textContent = 'Chưa có đơn hàng nào để theo dõi.';
                } else if (data.isAdmin) {
                    orderRealtimeText.textContent = `Hiện có ${data.activeCount ?? 0} đơn hàng đang cần xử lý.`;
                } else if (data.latestActiveOrderId) {
                    orderRealtimeText.textContent = `Đơn #DH${String(data.latestActiveOrderId).padStart(5, '0')} đang ở trạng thái ${activeMeta.text.toLowerCase()}.`;
                } else {
                    orderRealtimeText.textContent = 'Tất cả đơn hàng của bạn đã hoàn thành.';
                }
            }
            if (adminOrderNoticeText) {
                adminOrderNoticeText.textContent = `Hiện có ${data.activeCount ?? 0} đơn hàng đang cần theo dõi.`;
                if (data.latestOrderId && (latestSeenOrderId === null || data.latestOrderId > latestSeenOrderId)) {
                    adminOrderNoticeText.textContent = `Có đơn hàng mới #DH${String(data.latestOrderId).padStart(5, '0')} vừa được tạo.`;
                    window.showNewOrderToast?.(data.latestOrderId);
                    sessionStorage.setItem('coffeeLatteLatestAdminOrderId', String(data.latestOrderId));
                }
            }
            if (data.latestOrderId) latestSeenOrderId = data.latestOrderId;

            (data.orders || []).forEach(order => {
                const oldStatus = orderStatusCache.get(order.id);
                if (oldStatus && oldStatus !== order.status && orderRealtimeText && !data.isAdmin) {
                    const meta = statusMeta[order.status] || statusMeta.Pending;
                    orderRealtimeText.textContent = `Đơn #DH${String(order.id).padStart(5, '0')} vừa chuyển sang ${meta.text.toLowerCase()}.`;
                }
                orderStatusCache.set(order.id, order.status);
                setOrderProgress(order.id, order.status);
            });
            applyFilters();
        } catch {
            // Polling silently retries on the next tick.
        } finally {
            orderPollInFlight = false;
        }
    };

    window.setInterval(pollOrderRealtime, 5000);
    pollOrderRealtime();

    document.querySelectorAll('.ajax-order-status-form').forEach(form => {
        form.addEventListener('submit', async event => {
            event.preventDefault();
            const submitter = event.submitter;
            if (!submitter) return;

            const buttons = Array.from(form.querySelectorAll('button'));
            buttons.forEach(button => button.disabled = true);
            try {
                const formData = new FormData(form);
                formData.set('status', submitter.value);
                const response = await fetch(form.action, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    body: formData
                });
                if (!response.ok) throw new Error('Không thể cập nhật trạng thái đơn hàng.');
                const data = await response.json();
                orderStatusCache.set(data.orderId, data.status);
                setOrderProgress(data.orderId, data.status);
                if (adminOrderNoticeText) {
                    adminOrderNoticeText.textContent = `Đã cập nhật #DH${String(data.orderId).padStart(5, '0')} sang ${(statusMeta[data.status] || statusMeta.Pending).text.toLowerCase()}.`;
                }
                applyFilters();
                pollOrderRealtime();
            } catch {
                if (adminOrderNoticeText) adminOrderNoticeText.textContent = 'Cập nhật trạng thái thất bại. Vui lòng thử lại.';
            } finally {
                buttons.forEach(button => button.disabled = false);
            }
        });
    });
})();
</script>


