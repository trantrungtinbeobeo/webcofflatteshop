@model webcofflatteshop.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<main class="flex min-h-screen items-center justify-center bg-background px-margin-mobile py-section-gap">
    <section class="w-full max-w-md rounded-xl border border-outline-variant/20 bg-surface-container-lowest p-gutter shadow-[0_10px_30px_rgba(62,39,35,0.06)]">
        <a asp-controller="Product" asp-action="Index" class="mb-8 flex items-center justify-center gap-3">
            <partial name="_SakuraLogoMark" />
            <span class="font-headline-md text-headline-md">
                <span style="color:#3e2723">Coffe</span>
                <span style="color:#81c784">Latte</span>
                <span style="color:#f48fb1">Kawaii</span>
            </span>
        </a>

        <h1 class="mb-2 font-headline-md text-headline-md text-primary">Quên mật khẩu</h1>
        <p class="mb-6 text-body-md text-secondary">Nhập Gmail đã liên kết với tài khoản, hệ thống sẽ gửi liên kết đặt lại mật khẩu.</p>

        @if (TempData["ForgotPasswordMessage"] is string message)
        {
            <div class="mb-5 rounded-lg border border-[#81c784] bg-[#eef8ef] px-4 py-3 text-sm text-primary">@message</div>
        }

        <form asp-action="ForgotPassword" method="post" class="space-y-5">
            <div asp-validation-summary="All" class="rounded-lg bg-error-container px-4 py-3 text-sm text-on-error-container"></div>
            <div>
                <label asp-for="Email" class="mb-2 block font-label-md text-secondary">Gmail tài khoản</label>
                <input asp-for="Email" class="w-full rounded-lg border border-outline-variant bg-white px-4 py-3 outline-none focus:border-primary focus:ring-1 focus:ring-primary" autocomplete="email" placeholder="name@gmail.com" />
                <span asp-validation-for="Email" class="mt-1 block text-sm text-error"></span>
            </div>
            <button type="submit" class="w-full rounded-lg bg-primary px-4 py-3 font-label-md text-on-primary">Gửi liên kết đặt lại</button>
            <a asp-action="Login" class="block rounded-lg py-3 text-center font-label-md text-secondary hover:bg-surface-container">Quay lại đăng nhập</a>
        </form>
    </section>
</main>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
